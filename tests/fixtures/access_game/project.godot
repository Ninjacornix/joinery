; A tiny custom game (no Joinery game core) with accessibility problems planted on
; purpose, for joinery access's tests: grey text on a grey panel, 9 px text, a state
; shown by red or green alone, a button with no name, a voice line with no subtitles,
; keys only (no gamepad, no remapping, no pause), a held sprint and a flashing screen.
; Technical fixture; no game art.

config_version=5

[application]

config/name="Access Fixture"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

