[resource]
script = ExtResource("1_tree")
source = "# Guard: hits when close, chases what it sees, otherwise patrols.
selector
	sequence
		condition target_near
		cooldown 1.2
			action attack
	sequence
		condition sees_target
		action chase
	action patrol
"
