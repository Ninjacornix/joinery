{
  "enableAllProjectMcpServers": false,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--frozen",
              "--quiet",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "joinery",
              "hook",
              "--agent",
              "claude"
            ],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
