# Pinned tool versions for the sandbox image. Sourced by build.sh and
# fetch-checksums.sh, and passed to the Dockerfile as build args, so a version
# is written down once.
#
# Tools that Debian packages are not listed here: apt pins and GPG-verifies them
# (see the Dockerfile). Only direct downloads need a version and a hash, which
# live in checksums.txt and are produced by fetch-checksums.sh.
#
# Every URL below was confirmed to resolve on 2026-11-07. Changing a version
# means re-running fetch-checksums.sh, which rewrites checksums.txt and fails
# loudly if the new URL does not resolve.

# Godot. Must match godot_patches/UPSTREAM, which is the fork's base.
# -> Godot_v4.7.2-stable_linux.x86_64.zip (74MB)
GODOT_VERSION=4.7.2
GODOT_CHANNEL=stable

# Blender. PLAN requires 5.1+; 5.2 is the newest series.
# -> blender-5.2.1-linux-x64.tar.xz (366MB)
BLENDER_SERIES=5.2
BLENDER_VERSION=5.2.1

# MPFB2, the parametric-human addon driven through Blender's scripting API.
# Its releases carry no attached assets, so the tagged source archive is used
# and the addon package is taken from src/mpfb inside it.
MPFB2_VERSION=2.0.18

# Material Maker. PLAN requires 1.5+ for the CLI exporter; 1.8 is current.
# Ships a .tar.gz, not a .zip, and the version has no patch component.
MATERIALMAKER_VERSION=1.8

# Surge XT. Stable Linux releases live in surge-synthesizer/releases-xt (the
# main repo's "Nightly" tag moves). Installed in the creative worker layer.
# -> surge-xt-linux-x64-1.3.4.deb (223MB)
SURGE_VERSION=1.3.4

# Audacity, for the Audacity worker (audacity.Dockerfile). Debian trixie's own
# build (mod-script-pipe included), downloaded as the exact .deb pair and
# hash-checked like a direct download; apt then installs its dependencies from
# the GPG-verified archive. Trixie carries this version for its lifetime.
# -> audacity_3.7.3+dfsg-1_amd64.deb, audacity-data_3.7.3+dfsg-1_all.deb
AUDACITY_DEB_VERSION=3.7.3+dfsg-1

# The Godot MCP server, baked into the MCP worker image (mcp.Dockerfile) so it
# runs offline next to the worker's headless Godot. An exact commit of
# tugcantopaloglu/godot-mcp; must match policy/preferred_tools.toml's ref and
# mcp.Dockerfile's default. Its source archive is hash-checked like any other
# download, and npm ci installs from its lockfile's integrity hashes.
GODOT_MCP_REF=88f0fbc69a08225d4fdec32f921209e127f52395
