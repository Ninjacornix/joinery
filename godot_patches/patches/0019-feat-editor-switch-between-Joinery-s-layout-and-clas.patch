+bool EditorSettings::is_joinery_layout() {
+	static int layout = -1;
+	if (layout < 0) {
+		if (singleton.is_null() || !singleton->has_setting("interface/joinery/editor_layout")) {
+			return true; // Not loaded yet: ask again later rather than remember a guess.
+		}
+		layout = int(singleton->get_setting("interface/joinery/editor_layout"));
+	}
+	return layout == 0;
