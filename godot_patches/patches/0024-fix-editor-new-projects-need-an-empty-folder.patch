From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ninjacornix <milanvrankic@gmail.com>
Date: Tue, 10 Nov 2026 23:05:32 +0100
Subject: [PATCH] fix(editor): new projects need an empty folder

Joinery-only, not meant for upstream: it guards the Joinery wizard.

Upstream only warns when the folder is not empty and lets you go on.
The wizard then writes project.godot, the export presets, the icon and
the git and editor files, and merges a starting point into the folder,
so picking a folder that already held a game overwrote it.

Now a folder with a project.godot is refused with a pointer to the
project list, and any other folder with files in it is refused too.
Hidden files such as a .git folder stay allowed, as upstream allows,
except the .gitignore, .gitattributes and .editorconfig the wizard
writes itself. The folder is checked again right before anything is
written, in case it changed after it was picked.
---
 editor/project_manager/project_dialog.cpp | 51 +++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/editor/project_manager/project_dialog.cpp b/editor/project_manager/project_dialog.cpp
index e51d118..611086a 100644
--- a/editor/project_manager/project_dialog.cpp
+++ b/editor/project_manager/project_dialog.cpp
@@ -160,6 +160,41 @@ static bool is_zip_file(Ref<DirAccess> p_d, const String &p_path) {
 	return p_path.get_extension() == "zip" && p_d->file_exists(p_path);
 }
 
+// Joinery: creating a project writes project.godot, the export presets, the
+// icon, the git and editor files, then merges a starting point into the
+// folder. In a folder that already holds files that overwrites someone's work,
+// so the wizard needs an empty folder. Hidden files such as a .git folder are
+// fine, as upstream allows, except the ones the wizard writes itself. Returns
+// why the folder can't be used, or an empty string.
+static String _joinery_folder_problem(const String &p_path) {
+	Ref<DirAccess> d = DirAccess::create(DirAccess::ACCESS_FILESYSTEM);
+	if (!d->dir_exists(p_path)) {
+		return String();
+	}
+	if (d->file_exists(p_path.path_join("project.godot"))) {
+		return TTR("This folder already has a Godot project. Open it from the project list, or pick an empty folder.");
+	}
+	const String not_empty = TTR("This folder isn't empty. Pick an empty folder for a new game, so nothing already in it gets overwritten.");
+	for (const char *name : { ".gitignore", ".gitattributes", ".editorconfig" }) {
+		if (d->file_exists(p_path.path_join(name))) {
+			return not_empty;
+		}
+	}
+	if (d->change_dir(p_path) != OK) {
+		return String();
+	}
+	bool empty = true;
+	d->list_dir_begin();
+	for (String n = d->get_next(); !n.is_empty(); n = d->get_next()) {
+		if (n[0] != '.') {
+			empty = false;
+			break;
+		}
+	}
+	d->list_dir_end();
+	return empty ? String() : not_empty;
+}
+
 void ProjectDialog::_validate_path() {
 	_set_message("", MESSAGE_SUCCESS, PROJECT_PATH);
 	_set_message("", MESSAGE_SUCCESS, INSTALL_PATH);
@@ -324,6 +359,14 @@ void ProjectDialog::_validate_path() {
 			}
 			d->list_dir_end();
 
+			if (mode == MODE_NEW && joinery_wizard) {
+				const String problem = _joinery_folder_problem(target_path);
+				if (!problem.is_empty()) {
+					_set_message(problem, MESSAGE_ERROR, target_path_input_type);
+					return;
+				}
+			}
+
 			if (!is_folder_empty) {
 				_set_message(TTRC("The selected path is not empty. Choosing an empty folder is highly recommended."), MESSAGE_WARNING, target_path_input_type);
 			}
@@ -3353,6 +3396,14 @@ void ProjectDialog::_nonempty_confirmation_ok_pressed() {
 }
 
 void ProjectDialog::ok_pressed() {
+	// Joinery: check the folder again right before anything is written, since
+	// it may have changed after it was picked. It goes back to the first step,
+	// which says why.
+	if (mode == MODE_NEW && joinery_wizard && !joinery_files_ready && joinery_page != JOINERY_PAGE_CREATING && !_joinery_folder_problem(project_path->get_text().simplify_path()).is_empty()) {
+		_joinery_show_step(JOINERY_PAGE_NAME);
+		return;
+	}
+
 	// Before we create a project, check that the target folder is empty.
 	// If not, we need to ask the user if they're sure they want to do this.
 	if (!is_folder_empty) {
