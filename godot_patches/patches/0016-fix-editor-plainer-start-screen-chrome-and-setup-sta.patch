+// A step icon redrawn in one colour, keeping its shape's alpha: the editor's
+// own icons are tuned for the dark theme (a mint check, a pale grey spinner)
+// and fade out on the light ground.
+Ref<Texture2D> ProjectDialog::_joinery_step_icon(const StringName &p_icon, int p_state) const {
+	const Ref<Texture2D> icon = get_editor_theme_icon(p_icon);
+	if (icon.is_null() || p_state == JOINERY_STEP_PENDING) {
+		return icon;
+	}
+	Ref<Image> image = icon->get_image();
+	if (image.is_null() || image->is_empty()) {
+		return icon;
+	}
+	image = image->duplicate();
+	if (image->is_compressed()) {
+		image->decompress();
+	}
+	image->convert(Image::FORMAT_RGBA8);
+	const bool dark = EditorThemeManager::is_dark_theme();
+	Color tint = get_theme_color(SceneStringName(font_color), SNAME("Label"));
+	if (p_state == JOINERY_STEP_DONE) {
+		// At least 3:1 on either ground (#2a6f43 on #f7f6f3, #6cc38a on #202123).
+		tint = dark ? Color::html("#6cc38a") : Color::html("#2a6f43");
+	} else if (p_state == JOINERY_STEP_FAILED) {
+		tint = get_theme_color(SceneStringName(font_color), SNAME("JoineryError"));
+	}
+	for (int y = 0; y < image->get_height(); y++) {
+		for (int x = 0; x < image->get_width(); x++) {
+			const Color pixel = image->get_pixel(x, y);
+			image->set_pixel(x, y, Color(tint, pixel.a * tint.a));
+		}
+	}
+	return ImageTexture::create_from_image(image);
+}
