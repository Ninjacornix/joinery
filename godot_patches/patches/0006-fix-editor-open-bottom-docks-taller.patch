@@ -76,6 +77,13 @@ class EditorBottomPanel : public DockTabContainer {
 	void _update_center_split_offset();
 	EditorDock *_get_dock_from_control(Control *p_control) const;
 
+	// Joinery: the ⋮ menu lists every bottom dock, open or closed, and
