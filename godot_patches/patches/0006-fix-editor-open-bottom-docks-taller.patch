From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ninjacornix <milanvrankic@gmail.com>
Date: Sat, 7 Nov 2026 23:47:03 +0100
Subject: [PATCH] fix(editor): open bottom docks taller

Joinery-only shell preference. Not intended for upstream.
---
 editor/docks/dock_tab_container.cpp  |  3 ++
 editor/docks/editor_dock_manager.cpp | 14 ++++++
 editor/docks/editor_dock_manager.h   |  4 ++
 editor/docks/filesystem_dock.cpp     |  4 ++
 editor/editor_node.cpp               | 61 +++++++++++++++++++++++++-
 editor/gui/editor_bottom_panel.cpp   | 65 +++++++++++++++++++++++++---
 editor/gui/editor_bottom_panel.h     |  8 ++++
 7 files changed, 152 insertions(+), 7 deletions(-)

diff --git a/editor/docks/dock_tab_container.cpp b/editor/docks/dock_tab_container.cpp
index f03fe97..31dad08 100644
--- a/editor/docks/dock_tab_container.cpp
+++ b/editor/docks/dock_tab_container.cpp
@@ -153,6 +153,9 @@ void DockTabContainer::_pre_popup() {
 	if (dock_slot >= EditorDock::DOCK_SLOT_RIGHT_UL && dock_slot <= EditorDock::DOCK_SLOT_RIGHT_BR) {
 		return; // Joinery's assistant column has no docking menu.
 	}
+	if (get_popup() != dock_context_popup || !get_dock(get_current_tab())) {
+		return; // Joinery: the bottom panel's menu lists its docks instead.
+	}
 	dock_context_popup->set_dock(get_dock(get_current_tab()));
 }
 
diff --git a/editor/docks/editor_dock_manager.cpp b/editor/docks/editor_dock_manager.cpp
index 42997f5..b19fce3 100644
--- a/editor/docks/editor_dock_manager.cpp
+++ b/editor/docks/editor_dock_manager.cpp
@@ -718,6 +718,20 @@ void EditorDockManager::_make_dock_visible(EditorDock *p_dock, bool p_grab_focus
 	}
 }
 
+Vector<EditorDock *> EditorDockManager::get_slot_docks(int p_slot) const {
+	Vector<EditorDock *> docks;
+	for (EditorDock *dock : all_docks) {
+		if (!dock->enabled || !dock->global || (dock->transient && !dock->is_open)) {
+			continue;
+		}
+		const int slot = dock->dock_slot_index == EditorDock::DOCK_SLOT_NONE ? (int)dock->default_slot : dock->dock_slot_index;
+		if (slot == p_slot) {
+			docks.push_back(dock);
+		}
+	}
+	return docks;
+}
+
 void EditorDockManager::focus_dock(EditorDock *p_dock) {
 	ERR_FAIL_NULL(p_dock);
 	ERR_FAIL_COND_MSG(!all_docks.has(p_dock), vformat("Cannot focus unknown dock '%s'.", p_dock->get_display_title()));
diff --git a/editor/docks/editor_dock_manager.h b/editor/docks/editor_dock_manager.h
index c83a9eb..338bdc8 100644
--- a/editor/docks/editor_dock_manager.h
+++ b/editor/docks/editor_dock_manager.h
@@ -159,6 +159,10 @@ public:
 	void add_dock(EditorDock *p_dock);
 	void remove_dock(EditorDock *p_dock);
 
+	// Joinery: the docks that belong to a slot, open or closed, for that
+	// slot's own menu. Closed transient docks are left out, as in the layout.
+	Vector<EditorDock *> get_slot_docks(int p_slot) const;
+
 	EditorDockManager();
 };
 
diff --git a/editor/docks/filesystem_dock.cpp b/editor/docks/filesystem_dock.cpp
index a5b29e2..1900b54 100644
--- a/editor/docks/filesystem_dock.cpp
+++ b/editor/docks/filesystem_dock.cpp
@@ -4428,6 +4428,10 @@ void FileSystemDock::_bind_methods() {
 FileSystemDock::FileSystemDock() {
 	singleton = this;
 	set_name(TTRC("FileSystem"));
+	// Joinery: the tab reads "Files". The layout key stays "FileSystem", so
+	// saved layouts and the layout migration keep finding this dock.
+	set_layout_key("FileSystem");
