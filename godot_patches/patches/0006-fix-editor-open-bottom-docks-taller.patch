+	PopupMenu *joinery_docks_menu = nullptr;
+	Vector<EditorDock *> joinery_menu_docks;
+	void _joinery_fill_docks_menu();
+	void _joinery_docks_menu_option(int p_id);
+
 protected:
 	void _notification(int p_what);
 
