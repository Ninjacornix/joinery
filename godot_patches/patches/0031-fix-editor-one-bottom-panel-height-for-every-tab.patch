From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ninjacornix <milanvrankic@gmail.com>
Date: Fri, 13 Nov 2026 10:01:44 +0100
Subject: [PATCH] fix(editor): one bottom panel height for every tab

Joinery-only, not for upstream. The bottom panel opened each dock at its own saved height, raised to 35% for Output and Review and 25% for the rest, so the viewport jumped when switching tabs. In Joinery's layout every dock now shares one height, which only dragging the divider changes; until the first drag it is 35% of the work area. The classic view keeps a height per dock.
---
 editor/gui/editor_bottom_panel.cpp | 27 +++++++++++++++++----------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/editor/gui/editor_bottom_panel.cpp b/editor/gui/editor_bottom_panel.cpp
index 973e603..d697e2d 100644
--- a/editor/gui/editor_bottom_panel.cpp
+++ b/editor/gui/editor_bottom_panel.cpp
@@ -86,7 +86,15 @@ void EditorBottomPanel::_theme_changed() {
 	}
 }
 
+// Joinery: every bottom dock shares one height, which only dragging the
+// divider changes, so the viewport keeps its size when switching tabs.
+static const char *JOINERY_SHARED_OFFSET = "_joinery_shared";
+
 void EditorBottomPanel::set_bottom_panel_offset(int p_offset) {
+	if (EditorSettings::is_joinery_layout()) {
+		dock_offsets[JOINERY_SHARED_OFFSET] = p_offset;
+		return;
+	}
 	EditorDock *current_tab = Object::cast_to<EditorDock>(get_current_tab_control());
 	if (current_tab) {
 		dock_offsets[current_tab->get_effective_layout_key()] = p_offset;
@@ -94,6 +102,10 @@ void EditorBottomPanel::set_bottom_panel_offset(int p_offset) {
 }
 
 int EditorBottomPanel::get_bottom_panel_offset() {
+	if (EditorSettings::is_joinery_layout()) {
+		const int *shared = dock_offsets.getptr(JOINERY_SHARED_OFFSET);
+		return shared ? *shared : 0;
+	}
 	EditorDock *current_tab = Object::cast_to<EditorDock>(get_current_tab_control());
 	if (current_tab) {
 		return dock_offsets[current_tab->get_effective_layout_key()];
@@ -246,17 +258,12 @@ void EditorBottomPanel::_update_center_split_offset() {
 	DockSplitContainer *center_split = EditorNode::get_center_split();
 	ERR_FAIL_NULL(center_split);
 
-	// Joinery: opening a utility dock should reveal a useful work area, even
-	// when an earlier layout saved a nearly collapsed height. Larger sizes
-	// remain intact, and the divider can still be dragged while the dock is open.
-	// Output and Review hold long text or a large preview and open at 35% of
-	// the height; every other dock opens at 25% at least.
+	// Joinery: one height for every dock (see JOINERY_SHARED_OFFSET). Until
+	// the divider is first dragged, docks open at 35% of the height, enough
+	// for a review's before and after.
 	int offset = get_bottom_panel_offset();
-	EditorDock *current = Object::cast_to<EditorDock>(get_current_tab_control());
-	if (current && EditorSettings::is_joinery_layout()) {
-		const String key = current->get_effective_layout_key();
-		const float share = (key == "Output" || key == "Review") ? 0.35 : 0.25;
-		offset = MIN(offset, -int(center_split->get_size().y * share));
+	if (EditorSettings::is_joinery_layout() && !dock_offsets.has(JOINERY_SHARED_OFFSET)) {
+		offset = -int(center_split->get_size().y * 0.35);
 	}
 	center_split->set_split_offset(offset);
 }
