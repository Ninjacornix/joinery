+			picker->set_meta("required", required);
+			picker->set_meta("available", available);
 			String detail;
 			for (int o = 0; o < options.size(); o++) {
 				Dictionary option = options[o];
 				String label = String(option.get("label", ""));
 				String state = String(option.get("state", ""));
 				String summary = String(option.get("summary", ""));
-				// Each line explains itself. "rejected" on its own is Joinery's
-				// vetting vocabulary and means nothing to someone making a
-				// project; "blocked: sends telemetry" does.
-				String prefix = state == "rejected" ? String(TTRC("blocked: ")) : String();
+				// Preference explains the default; it does not forbid a custom MCP.
+				String prefix = state == "alternative" ? String(TTRC("not preferred: ")) : String();
 				String item = summary.is_empty() ? label
 												 : label + "  (" + prefix + summary + ")";
 				picker->add_item(item);
