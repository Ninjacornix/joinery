+// Creating a project is the moment the apps that will make it are chosen, so a
+// new project takes three steps: Name your game, Choose your apps, and an
+// optional Look and sound page that seeds the art bible. Next walks the steps
+// and Create project finishes, which keeps the whole decision in this window.
 //
-// The questionnaire is built from `joinery tools --json`, so the catalog and
-// its admission rules stay the single source of truth; this code cannot invent
-// a tool or present an unavailable one as selectable. If Joinery is not
-// installed the page is skipped entirely and the dialog behaves like stock
-// Godot, because a missing sidebar is not a reason to block making a project.
+// The app list and the questions come from the `joinery` CLI, so the catalog
+// and its admission rules stay the single source of truth; this code cannot
+// invent an app or present an unavailable one as selectable. The CLI always
+// runs on a worker thread, so the dialog never freezes, and every failure is
+// shown in the dialog with a way forward rather than only printed.
+
+// The shared spacing scale (4, 8, 12, 16, 24, 32), in editor-scaled pixels.
+// The Journeyman sidebar uses the same steps, so both read as one product.
+static int _joinery_space(int p_step) {
+	static const int steps[] = { 0, 4, 8, 12, 16, 24, 32 };
+	return steps[CLAMP(p_step, 0, 6)] * EDSCALE;
+}
+
+// The first readable line of CLI output, short enough for a sentence.
+static String _joinery_first_line(const String &p_text) {
+	const Vector<String> lines = p_text.split("\n", false);
+	for (const String &line : lines) {
+		const String clean = line.strip_edges();
+		if (!clean.is_empty()) {
+			return clean.length() > 120 ? clean.substr(0, 120) + String::utf8("…") : clean;
+		}
+	}
+	return String();
+}
+
+// Pulls the JSON object out of CLI output. uv can print notes around it, so
+// this takes the outermost braces rather than requiring a clean stream.
+static bool _joinery_parse_json(const String &p_output, int p_exit, Dictionary &r_doc, String &r_reason) {
+	if (p_exit != 0) {
+		const String line = _joinery_first_line(p_output);
+		if (p_exit < 0) {
+			r_reason = TTR("uv couldn't be started");
+		} else {
+			r_reason = line.is_empty() ? vformat(TTR("it stopped with code %d"), p_exit) : line;
+		}
+		return false;
+	}
+	const int from = p_output.find_char('{');
+	const int to = p_output.rfind_char('}');
+	if (from < 0 || to < from) {
+		r_reason = TTR("it sent no data");
+		return false;
+	}
+	Ref<JSON> json;
+	json.instantiate();
+	if (json->parse(p_output.substr(from, to - from + 1)) != OK || json->get_data().get_type() != Variant::DICTIONARY) {
+		r_reason = TTR("its reply couldn't be read");
+		return false;
+	}
+	r_doc = json->get_data();
+	return true;
+}
 
