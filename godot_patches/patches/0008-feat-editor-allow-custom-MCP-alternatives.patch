+	joinery_create_labels[p_step]->set_theme_type_variation(p_state == JOINERY_STEP_PENDING ? StringName("JoineryMuted") : StringName());
+}
+
+void ProjectDialog::_joinery_create_finished() {
+	joinery_create_thread.wait_to_finish();
+	joinery_create_running = false;
+	joinery_create_bar->hide();
+	joinery_choices_file.unref();
+	joinery_create_failed = joinery_thread_failed;
+
+	if (joinery_create_failed >= 0) {
+		_joinery_show_create_error(joinery_create_failed, joinery_create_outputs[joinery_create_failed]);
+		return;
+	}
+	if (!is_visible() || joinery_page != JOINERY_PAGE_CREATING) {
+		// Closed while working: nothing was registered, so nothing opens.
+		return;
+	}
+	// The stock writer below reads the path field; make sure it is the folder
+	// the worker just filled, whatever happened to the field meanwhile.
+	project_path->set_text(joinery_job_path);
+
+	// All three succeeded: write project.godot, the icon and the rest exactly
+	// as stock Godot does, then open the editor.
+	is_folder_empty = true;
+	joinery_files_ready = true;
+	ok_pressed();
+	joinery_files_ready = false;
+	if (is_visible()) {
+		// The stock writer reported a problem through msg; resume from it.
+		joinery_create_failed = JOINERY_CREATE_STEPS;
+		_joinery_show_create_error(JOINERY_CREATE_STEPS, msg->get_text());
+	}
+}
+
+void ProjectDialog::_joinery_show_create_error(int p_step, const String &p_output) {
+	static const char *failures[] = {
+		TTRC("Couldn't copy Joinery into the project."),
+		TTRC("Couldn't save your apps."),
+		TTRC("Couldn't write the art direction."),
+		TTRC("Couldn't finish the project files."),
+	};
+	joinery_create_from = CLAMP(p_step, 0, JOINERY_CREATE_STEPS);
+	joinery_create_error->set_text(TTR(failures[CLAMP(p_step, 0, 3)]) + " " + TTR("Retry, or cancel and check the details."));
+	joinery_create_error->show();
+	joinery_details->set_text(p_output.strip_edges());
+	joinery_details_button->set_visible(!p_output.strip_edges().is_empty());
+	joinery_details_button->set_pressed(false);
+	joinery_details->hide();
+	_joinery_show_step(JOINERY_PAGE_CREATING);
+}
+
+void ProjectDialog::_joinery_retry_create() {
+	if (joinery_create_running) {
+		return;
+	}
+	for (int i = joinery_create_from; i < JOINERY_CREATE_STEPS; i++) {
+		_joinery_create_progress(i, JOINERY_STEP_PENDING);
+	}
+	joinery_create_failed = -1;
+	joinery_details_button->hide();
+	joinery_details->hide();
+	_joinery_start_create();
+}
+
+void ProjectDialog::_joinery_toggle_details(bool p_open) {
+	joinery_details->set_visible(p_open);
+	joinery_details_button->set_button_icon(get_editor_theme_icon(p_open ? SNAME("GuiTreeArrowDown") : SNAME("GuiTreeArrowRight")));
 }
 
