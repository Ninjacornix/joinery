-		// decision instead of a shortlist.
+		// popular ones and why they lost is worth seeing. Alternatives are
+		// selectable as project-owned custom MCPs with explicit launch details.
 		Array options = tool.get("mcp_options", Array());
+		OptionButton *choice_picker = nullptr;
+		LineEdit *choice_command = nullptr;
+		LineEdit *choice_arguments = nullptr;
 		bool starred = tool.get("recommended", false);
-		if (options.size() > 1) {
+		if (options.size() > 1 || (options.size() == 1 && Dictionary(options[0]).has("custom"))) {
 			OptionButton *picker = memnew(OptionButton);
+			choice_picker = picker;
+			picker->set_fit_to_longest_item(false);
