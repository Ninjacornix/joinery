+// The × that takes a file off the list, named for screen readers, a square
+// one control tall so it is easy to hit.
+static Button *_joinery_remove_button(const String &p_name, int p_side) {
+	Button *remove = memnew(Button);
+	remove->set_custom_minimum_size(Size2(p_side, p_side));
+	remove->set_theme_type_variation(SNAME("JoineryTextButton"));
+	remove->set_text(String::utf8("×"));
+	remove->set_tooltip_text(vformat(TTR("Remove %s"), p_name));
+	remove->set_accessibility_name(vformat(TTR("Remove %s"), p_name));
+	remove->set_v_size_flags(Control::SIZE_SHRINK_CENTER);
+	return remove;
+}
+
+static Label *_joinery_file_name(const String &p_name) {
+	Label *name = memnew(Label);
+	name->set_theme_type_variation(SNAME("JoineryLabel"));
+	name->set_text(p_name);
+	name->set_tooltip_text(p_name);
+	name->set_mouse_filter(Control::MOUSE_FILTER_PASS);
+	name->set_text_overrun_behavior(TextServer::OVERRUN_TRIM_ELLIPSIS);
+	name->set_auto_translate_mode(Node::AUTO_TRANSLATE_MODE_DISABLED);
+	name->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+	return name;
+}
