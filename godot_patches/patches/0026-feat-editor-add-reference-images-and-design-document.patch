+// The user's own material on step 3: reference images under References and
+// design documents under Game brief. Only what they pick or drop is listed;
+// the CLI checks every file again and copies it in (setup_imports.py).
+
+static const int JOINERY_MAX_REFERENCES = 20;
+static const int JOINERY_MAX_DOCUMENTS = 10;
+
+static bool _joinery_is_image(const String &p_path) {
+	const String ext = p_path.get_extension().to_lower();
+	return ext == "png" || ext == "jpg" || ext == "jpeg" || ext == "webp";
+}
+
+static bool _joinery_is_document(const String &p_path) {
+	const String ext = p_path.get_extension().to_lower();
+	return ext == "md" || ext == "markdown" || ext == "txt" || ext == "pdf";
+}
+
+void ProjectDialog::_joinery_build_imports(VBoxContainer *p_brief_section) {
+	const auto block = [this](VBoxContainer *p_parent, const String &p_label, const String &p_caption) {
+		VBoxContainer *box = memnew(VBoxContainer);
+		box->add_theme_constant_override(SNAME("separation"), _joinery_space(2));
+		p_parent->add_child(box);
+		Label *label = memnew(Label);
+		label->set_theme_type_variation(SNAME("JoineryLabel"));
+		label->set_text(p_label);
+		box->add_child(label);
+		box->add_child(_joinery_caption(p_caption));
+		return box;
+	};
+	const auto add_button = [](VBoxContainer *p_box, const String &p_text, Label **r_error) {
+		VBoxContainer *rows = memnew(VBoxContainer);
+		rows->add_theme_constant_override(SNAME("separation"), _joinery_space(2));
+		p_box->add_child(rows);
+		Button *button = memnew(Button);
+		button->set_theme_type_variation(SNAME("JoinerySecondaryButton"));
+		button->set_text(p_text);
+		button->set_h_size_flags(Control::SIZE_SHRINK_BEGIN);
+		p_box->add_child(button);
+		*r_error = memnew(Label);
+		(*r_error)->set_theme_type_variation(SNAME("JoineryError"));
+		(*r_error)->set_autowrap_mode(TextServer::AUTOWRAP_WORD_SMART);
+		(*r_error)->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+		(*r_error)->set_accessibility_live(AccessibilityServerEnums::LIVE_POLITE);
+		(*r_error)->hide();
+		p_box->add_child(*r_error);
+		return Pair<VBoxContainer *, Button *>(rows, button);
+	};
+
+	VBoxContainer *docs = block(p_brief_section, TTR("Design documents"), TTR("Your design document or notes: Markdown, text or PDF, up to 10. Open parts of the brief are copied from their matching headings."));
+	Pair<VBoxContainer *, Button *> doc_parts = add_button(docs, TTR(String::utf8("Add documents…")), &joinery_doc_error);
+	joinery_doc_rows = doc_parts.first;
+	joinery_doc_add = doc_parts.second;
+	joinery_doc_add->connect(SceneStringName(pressed), callable_mp(this, &ProjectDialog::_joinery_browse_documents));
+
+	VBoxContainer *refs = block(joinery_look_page, TTR("Reference images"), TTR("Your own pictures: PNG, JPEG or WebP, up to 20. Drop them on this window or add them, and say what to take from each."));
+	Pair<VBoxContainer *, Button *> ref_parts = add_button(refs, TTR(String::utf8("Add images…")), &joinery_ref_error);
+	joinery_ref_rows = ref_parts.first;
+	joinery_ref_add = ref_parts.second;
+	joinery_ref_add->connect(SceneStringName(pressed), callable_mp(this, &ProjectDialog::_joinery_browse_references));
+
+	joinery_ref_dialog = memnew(EditorFileDialog);
+	joinery_ref_dialog->set_access(EditorFileDialog::ACCESS_FILESYSTEM);
+	joinery_ref_dialog->set_file_mode(EditorFileDialog::FILE_MODE_OPEN_FILES);
+	joinery_ref_dialog->set_title(TTR("Add reference images"));
+	joinery_ref_dialog->add_filter("*.png,*.jpg,*.jpeg,*.webp", TTR("Images"));
+	joinery_ref_dialog->connect("files_selected", callable_mp(this, &ProjectDialog::_joinery_add_references));
+	add_child(joinery_ref_dialog);
+	joinery_doc_dialog = memnew(EditorFileDialog);
+	joinery_doc_dialog->set_access(EditorFileDialog::ACCESS_FILESYSTEM);
+	joinery_doc_dialog->set_file_mode(EditorFileDialog::FILE_MODE_OPEN_FILES);
+	joinery_doc_dialog->set_title(TTR("Add design documents"));
+	joinery_doc_dialog->add_filter("*.md,*.markdown,*.txt,*.pdf", TTR("Markdown, text or PDF"));
+	joinery_doc_dialog->connect("files_selected", callable_mp(this, &ProjectDialog::_joinery_add_documents));
+	add_child(joinery_doc_dialog);
+}
+
+void ProjectDialog::_joinery_browse_references() {
+	joinery_ref_dialog->popup_file_dialog();
+}
+
+void ProjectDialog::_joinery_browse_documents() {
+	joinery_doc_dialog->popup_file_dialog();
+}
