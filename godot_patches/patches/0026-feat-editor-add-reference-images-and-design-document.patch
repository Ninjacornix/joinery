+void ProjectDialog::_joinery_add_references(const PackedStringArray &p_paths) {
+	String problem;
+	const int thumb = _joinery_control_h(2.5) * 2;
+	for (const String &raw : p_paths) {
+		const String path = raw.simplify_path();
+		const String name = path.get_file();
+		if (DirAccess::dir_exists_absolute(path)) {
+			problem = vformat(TTR("%s is a folder. Pick the files inside it instead."), name);
+			continue;
+		}
+		if (!_joinery_is_image(path)) {
+			problem = vformat(TTR("%s isn't a picture. References can be PNG, JPEG or WebP images."), name);
+			if (_joinery_is_document(path)) {
+				problem += " " + TTR("If it describes the game, add it under Design documents.");
+			}
+			continue;
+		}
+		if (joinery_ref_paths.has(path)) {
+			continue;
+		}
+		if (joinery_ref_paths.size() >= JOINERY_MAX_REFERENCES) {
+			problem = vformat(TTR("Add up to %d references."), JOINERY_MAX_REFERENCES);
+			break;
+		}
+		Ref<Image> image = Image::load_from_file(path);
+		if (image.is_null() || image->is_empty()) {
+			problem = vformat(TTR("%s doesn't hold a picture Joinery can read."), name);
+			continue;
+		}
+		// A small copy for the thumbnail; the file itself is copied unchanged.
+		const float scale = MIN(1.0f, (float)thumb / MAX(1, MAX(image->get_width(), image->get_height())));
+		if (scale < 1.0f) {
+			image->resize(MAX(1, (int)(image->get_width() * scale)), MAX(1, (int)(image->get_height() * scale)), Image::INTERPOLATE_BILINEAR);
+		}
+
+		HBoxContainer *row = memnew(HBoxContainer);
+		row->add_theme_constant_override(SNAME("separation"), _joinery_space(3));
+		TextureRect *picture = memnew(TextureRect);
+		picture->set_texture(ImageTexture::create_from_image(image));
+		picture->set_expand_mode(TextureRect::EXPAND_IGNORE_SIZE);
+		picture->set_stretch_mode(TextureRect::STRETCH_KEEP_ASPECT_COVERED);
+		picture->set_clip_contents(true);
+		picture->set_custom_minimum_size(Size2(thumb, thumb));
+		picture->set_v_size_flags(Control::SIZE_SHRINK_CENTER);
+		row->add_child(picture);
+		VBoxContainer *words = memnew(VBoxContainer);
+		words->add_theme_constant_override(SNAME("separation"), _joinery_space(1));
+		words->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+		words->set_v_size_flags(Control::SIZE_SHRINK_CENTER);
+		row->add_child(words);
+		words->add_child(_joinery_file_name(name));
+		LineEdit *note = memnew(LineEdit);
+		note->set_theme_type_variation(SNAME("JoineryField"));
+		note->set_placeholder(TTR("What to take from it (optional)"));
+		note->set_accessibility_name(vformat(TTR("What to take from %s"), name));
+		note->set_max_length(200);
+		note->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+		note->set_custom_minimum_size(Size2(0, _joinery_control_h(2.5)));
+		words->add_child(note);
+		Button *remove = _joinery_remove_button(name, _joinery_control_h(2.5));
+		remove->connect(SceneStringName(pressed), callable_mp(this, &ProjectDialog::_joinery_remove_reference).bind(path));
+		row->add_child(remove);
+		joinery_ref_rows->add_child(row);
+		joinery_ref_paths.push_back(path);
+		joinery_ref_notes.push_back(note);
+		joinery_ref_row_nodes.push_back(row);
+	}
+	joinery_ref_error->set_text(problem);
+	joinery_ref_error->set_visible(!problem.is_empty());
+	_joinery_update_import_buttons();
+}
+
+void ProjectDialog::_joinery_add_documents(const PackedStringArray &p_paths) {
+	String problem;
+	for (const String &raw : p_paths) {
+		const String path = raw.simplify_path();
+		const String name = path.get_file();
+		if (DirAccess::dir_exists_absolute(path)) {
+			problem = vformat(TTR("%s is a folder. Pick the files inside it instead."), name);
+			continue;
+		}
+		if (!_joinery_is_document(path)) {
+			problem = vformat(TTR("%s can't be a design document. Use Markdown (.md), text (.txt) or PDF."), name);
+			continue;
+		}
+		if (joinery_doc_paths.has(path)) {
+			continue;
+		}
+		if (joinery_doc_paths.size() >= JOINERY_MAX_DOCUMENTS) {
+			problem = vformat(TTR("Add up to %d design documents."), JOINERY_MAX_DOCUMENTS);
+			break;
+		}
+		const String ext = path.get_extension().to_lower();
+		HBoxContainer *row = memnew(HBoxContainer);
+		row->add_theme_constant_override(SNAME("separation"), _joinery_space(3));
+		row->set_custom_minimum_size(Size2(0, _joinery_control_h(2.5)));
+		row->add_child(_joinery_file_name(name));
+		Label *kind = memnew(Label);
+		kind->set_theme_type_variation(SNAME("JoineryCaption"));
+		kind->set_text(ext == "pdf" ? TTR("PDF") : (ext == "txt" ? TTR("Text") : TTR("Markdown")));
+		row->add_child(kind);
+		Button *remove = _joinery_remove_button(name, _joinery_control_h(2.5));
+		remove->connect(SceneStringName(pressed), callable_mp(this, &ProjectDialog::_joinery_remove_document).bind(path));
+		row->add_child(remove);
+		joinery_doc_rows->add_child(row);
+		joinery_doc_paths.push_back(path);
+		joinery_doc_row_nodes.push_back(row);
+	}
+	joinery_doc_error->set_text(problem);
+	joinery_doc_error->set_visible(!problem.is_empty());
+	_joinery_update_import_buttons();
+}
+
+void ProjectDialog::_joinery_remove_reference(const String &p_path) {
+	const int index = joinery_ref_paths.find(p_path);
+	if (index < 0) {
+		return;
+	}
+	joinery_ref_row_nodes[index]->queue_free();
+	joinery_ref_paths.remove_at(index);
+	joinery_ref_notes.remove_at(index);
+	joinery_ref_row_nodes.remove_at(index);
+	joinery_ref_error->hide();
+	_joinery_update_import_buttons();
+	joinery_ref_add->grab_focus();
+}
+
+void ProjectDialog::_joinery_remove_document(const String &p_path) {
+	const int index = joinery_doc_paths.find(p_path);
+	if (index < 0) {
+		return;
+	}
+	joinery_doc_row_nodes[index]->queue_free();
+	joinery_doc_paths.remove_at(index);
+	joinery_doc_row_nodes.remove_at(index);
+	joinery_doc_error->hide();
+	_joinery_update_import_buttons();
+	joinery_doc_add->grab_focus();
+}
+
+void ProjectDialog::_joinery_update_import_buttons() {
+	joinery_ref_add->set_disabled(joinery_ref_paths.size() >= JOINERY_MAX_REFERENCES);
+	joinery_doc_add->set_disabled(joinery_doc_paths.size() >= JOINERY_MAX_DOCUMENTS);
+}
+
+void ProjectDialog::_joinery_clear_imports() {
+	for (Control *row : joinery_ref_row_nodes) {
+		memdelete(row);
+	}
+	for (Control *row : joinery_doc_row_nodes) {
+		memdelete(row);
+	}
+	joinery_ref_paths.clear();
+	joinery_ref_notes.clear();
+	joinery_ref_row_nodes.clear();
+	joinery_doc_paths.clear();
+	joinery_doc_row_nodes.clear();
+	joinery_ref_error->hide();
+	joinery_doc_error->hide();
+	_joinery_update_import_buttons();
+}
+
+bool ProjectDialog::joinery_take_dropped_files(const PackedStringArray &p_files) {
+	if (!joinery_wizard || !is_visible() || joinery_page != JOINERY_PAGE_LOOK) {
+		return false;
+	}
+	PackedStringArray images;
+	PackedStringArray documents;
+	String other;
+	for (const String &file : p_files) {
+		if (_joinery_is_document(file)) {
+			documents.push_back(file);
+		} else if (_joinery_is_image(file) || DirAccess::dir_exists_absolute(file)) {
+			images.push_back(file);
+		} else {
+			other = file.get_file();
+		}
+	}
+	if (!images.is_empty()) {
+		_joinery_add_references(images);
+	}
+	if (!documents.is_empty()) {
+		_joinery_add_documents(documents);
+	}
+	if (!other.is_empty()) {
+		joinery_ref_error->set_text(vformat(TTR("%s isn't a picture or a design document. Drop PNG, JPEG or WebP pictures, or Markdown, text or PDF documents."), other));
+		joinery_ref_error->show();
+	}
+	return true;
+}
