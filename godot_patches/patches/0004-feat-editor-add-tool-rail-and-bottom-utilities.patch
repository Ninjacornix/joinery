diff --git a/editor/editor_node.cpp b/editor/editor_node.cpp
index c3b2686..420e89b 100644
--- a/editor/editor_node.cpp
+++ b/editor/editor_node.cpp
@@ -6339,6 +6339,29 @@ void EditorNode::_load_editor_layout() {
 		}
 	} else {
 		ep.step(TTR("Loading docks..."), 1, true);
+		// Joinery: migrate existing projects once, retaining unrelated docks,
+		// closed panels, scene tabs and floating-window choices. Later manual
+		// layout changes remain the user's own.
+		if (int(config->get_value(EDITOR_NODE_CONFIG_SECTION, "joinery_shell_layout", 0)) < 1) {
+			PackedStringArray utilities = { "Scene", "FileSystem", "Import", "History", "Inspector", "Signals", "Groups" };
+			PackedStringArray bottom;
+			for (int slot = 1; slot <= EditorDock::DOCK_SLOT_MAX; slot++) {
+				String key = "dock_" + itos(slot);
+				PackedStringArray names = String(config->get_value("docks", key, "")).split(",", false);
+				PackedStringArray retained;
+				for (const String &name : names) {
+					if (!utilities.has(name)) {
+						retained.append(name);
+					}
+				}
+				config->set_value("docks", key, String(",").join(retained));
+				if (slot == EditorDock::DOCK_SLOT_BOTTOM + 1) {
+					bottom = retained;
+				}
+			}
+			utilities.append_array(bottom);
+			config->set_value("docks", "dock_9", String(",").join(utilities));
+		}
 		editor_dock_manager->load_docks_from_config(config, "docks", true);
 
 		ep.step(TTR("Reopening scenes..."), 2, true);
@@ -6356,6 +6379,7 @@ void EditorNode::_load_editor_layout() {
 }
 
