From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ninjacornix <milanvrankic@gmail.com>
Date: Thu, 12 Nov 2026 12:40:06 +0100
Subject: [PATCH] feat(editor): wear Joinery's icon in the editor

The editor and project manager now show Joinery's icon instead of
Godot's: the window icon (main/app_icon_editor.png, and a variant on
Apple's icon grid for the macOS Dock), the boot splash
(main/splash_editor.png on #202123, so no_editor_splash now defaults to
no), the icon embedded in the Windows executable (godot.ico), and the
mark beside the project manager's wordmark (editor/icons/JoineryLogo.svg).

Games keep Godot's: app_icon.png and splash.png are untouched, and a
game run from the editor without an icon of its own still gets Godot's
icon. The About dialog keeps Godot's logo and credits.

The images are built from hand-drawn SVGs by Joinery's
release/icon/build_icons.py.

This is Joinery branding, not intended for upstream.
---
 SConstruct                                 |   3 ++-
 editor/icons/JoineryLogo.svg               |  11 +++++++++++
 editor/project_manager/project_manager.cpp |  10 ++++++++++
 editor/project_manager/project_manager.h   |   1 +
 editor/themes/editor_icons.cpp             |   1 +
 main/SCsub                                 |   9 +++++++++
 main/app_icon_editor.png                   | Bin 0 -> 4458 bytes
 main/app_icon_editor_macos.png             | Bin 0 -> 4058 bytes
 main/main.cpp                              |  15 ++++++++++++++-
 main/main_builders.py                      |  21 ++++++++++++++++++++-
 main/splash_editor.png                     | Bin 0 -> 5823 bytes
 platform/windows/godot.ico                 | Bin 142638 -> 10772 bytes
 12 files changed, 68 insertions(+), 3 deletions(-)
 create mode 100644 editor/icons/JoineryLogo.svg
 create mode 100644 main/app_icon_editor.png
 create mode 100644 main/app_icon_editor_macos.png
 create mode 100644 main/splash_editor.png

diff --git a/SConstruct b/SConstruct
index d8d9301..f85a2b9 100644
--- a/SConstruct
+++ b/SConstruct
@@ -280,7 +280,8 @@ opts.Add("build_profile", "Path to a file containing a feature build profile", "
 opts.Add("custom_modules", "A list of comma-separated directory paths containing custom modules to build.", "")
 opts.Add(BoolVariable("custom_modules_recursive", "Detect custom modules recursively for each specified path.", True))
 opts.Add(BoolVariable("modules_enabled_by_default", "If no, disable all modules except ones explicitly enabled", True))
-opts.Add(BoolVariable("no_editor_splash", "Don't use the custom splash screen for the editor", True))
+# Joinery: the editor boots on its own splash (main/splash_editor.png).
+opts.Add(BoolVariable("no_editor_splash", "Don't use the custom splash screen for the editor", False))
 opts.Add(
     "system_certs_path",
     "Use this path as TLS certificates default for editor and Linux/BSD export templates (for package maintainers)",
diff --git a/editor/icons/JoineryLogo.svg b/editor/icons/JoineryLogo.svg
new file mode 100644
index 0000000..e781a5e
--- /dev/null
+++ b/editor/icons/JoineryLogo.svg
@@ -0,0 +1,11 @@
+<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 1024 1024">
+  <!-- Joinery app icon: a through dovetail. The brass tail board sits in the
+       socket of the pin board below it, with a thin shadow line between them.
+       Hand-written geometry; every raster is made from this file by
+       release/icon/build_icons.py. -->
+  <rect width="1024" height="1024" rx="228" fill="#202123"/>
+  <!-- Tail board: a rail with one tail flaring 1:2.9 below it. -->
+  <path fill="#e6b66b" d="M212 240H812V440H612L682 640H342L412 440H212Z"/>
+  <!-- Pin board: the socket is the tail offset outward by 36 units. -->
+  <path fill="#b07d36" d="M212 476H361.2L291.2 676H732.8L662.8 476H812V784H212Z"/>
+</svg>
diff --git a/editor/project_manager/project_manager.cpp b/editor/project_manager/project_manager.cpp
index 966455f..6c793da 100644
--- a/editor/project_manager/project_manager.cpp
+++ b/editor/project_manager/project_manager.cpp
@@ -268,6 +268,7 @@ void ProjectManager::_update_theme(bool p_skip_creation) {
 			main_view_container->add_theme_style_override(SceneStringName(panel), bare);
 		}
 		_joinery_fit_header();
+		_joinery_set_mark();
 
 		// Joinery: this is Joinery's project manager, so it says so. The upstream
 		// logo is an icon; replace it with the word, in the display size and
@@ -2075,6 +2076,14 @@ ProjectManager::ProjectManager() {
 	_joinery_show_connection();
 }
 
+// The Joinery mark (editor/icons/JoineryLogo.svg) leads the wordmark. Read
+// from the theme itself: the header is built before it enters the tree.
+void ProjectManager::_joinery_set_mark() {
+	if (joinery_wordmark && theme.is_valid()) {
+		joinery_wordmark->set_button_icon(theme->get_icon(SNAME("JoineryLogo"), EditorStringName(EditorIcons)));
+	}
+}
+
 // The header's side insets are the page panel's content margins, so the
 // wordmark starts on the same left edge as everything inside the page.
 void ProjectManager::_joinery_fit_header() {
@@ -2249,6 +2258,7 @@ void ProjectManager::_joinery_simplify() {
 		joinery_wordmark = memnew(Button);
 		joinery_wordmark->set_theme_type_variation(SNAME("JoineryWordmark"));
 		joinery_wordmark->set_text("Joinery");
+		_joinery_set_mark();
 		joinery_wordmark->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
 		joinery_wordmark->set_tooltip_text(TTR("About Joinery"));
 		joinery_wordmark->set_h_size_flags(Control::SIZE_SHRINK_BEGIN);
diff --git a/editor/project_manager/project_manager.h b/editor/project_manager/project_manager.h
index d8739e2..2933473 100644
--- a/editor/project_manager/project_manager.h
+++ b/editor/project_manager/project_manager.h
@@ -189,6 +189,7 @@ class ProjectManager : public Control {
 	MarginContainer *joinery_header = nullptr;
 	Label *joinery_tagline = nullptr;
 	void _joinery_fit_header();
+	void _joinery_set_mark();
 	String joinery_home;
 	void _joinery_update_agent_chip();
 
diff --git a/editor/themes/editor_icons.cpp b/editor/themes/editor_icons.cpp
index 8034c59..c8f62d4 100644
--- a/editor/themes/editor_icons.cpp
+++ b/editor/themes/editor_icons.cpp
@@ -113,6 +113,7 @@ void editor_register_icons(const Ref<Theme> &p_theme, bool p_dark_theme, float p
 	saturation_exceptions.insert("GodotFile");
 	saturation_exceptions.insert("Logo");
 	saturation_exceptions.insert("TitleBarLogo");
+	saturation_exceptions.insert("JoineryLogo");
 
 	// Accent color conversion map.
 	// It is used on some icons (checkbox, radio, toggle, etc.), regardless of the dark
diff --git a/main/SCsub b/main/SCsub
index 18e6a7b..158ba6d 100644
--- a/main/SCsub
+++ b/main/SCsub
@@ -36,5 +36,14 @@ env_main.CommandNoCache(
     env.Run(main_builders.make_app_icon),
 )
 
+# Joinery: the editor and project manager wear Joinery's icon; a game run from
+# the editor without an icon of its own keeps Godot's (app_icon.png).
+if env_main.editor_build:
+    env_main.CommandNoCache(
+        "#main/app_icon_editor.gen.h",
+        ["#main/app_icon_editor.png", "#main/app_icon_editor_macos.png"],
+        env.Run(main_builders.make_app_icon_editor),
+    )
+
 lib = env_main.add_library("main", env.main_sources)
 env.Prepend(LIBS=[lib])
