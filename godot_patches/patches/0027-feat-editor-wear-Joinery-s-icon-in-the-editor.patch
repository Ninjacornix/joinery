@@ -3991,7 +3992,8 @@ void Main::setup_boot_logo() {
 
 #if defined(TOOLS_ENABLED) && defined(MACOS_ENABLED)
 		if (DisplayServer::get_singleton()->has_feature(DisplayServerEnums::FEATURE_ICON) && OS::get_singleton()->get_bundle_icon_path().is_empty()) {
-			Ref<Image> icon = memnew(Image(app_icon_png));
+			// Joinery: the editor's Dock icon is Joinery's; a game keeps Godot's.
+			Ref<Image> icon = (editor || project_manager) ? memnew(Image(app_icon_editor_macos_png)) : memnew(Image(app_icon_png));
 			DisplayServer::get_singleton()->set_icon(icon);
 		}
 #endif
@@ -4834,6 +4836,17 @@ int Main::start() {
 
 	if (DisplayServer::get_singleton()->has_feature(DisplayServerEnums::FEATURE_ICON) && !has_icon && OS::get_singleton()->get_bundle_icon_path().is_empty()) {
 		Ref<Image> icon = memnew(Image(app_icon_png));
+#ifdef TOOLS_ENABLED
+		// Joinery: the editor and project manager wear Joinery's icon; a game run
+		// from the editor without an icon of its own keeps Godot's.
+		if (editor || project_manager) {
+#ifdef MACOS_ENABLED
+			icon = memnew(Image(app_icon_editor_macos_png));
+#else
+			icon = memnew(Image(app_icon_editor_png));
+#endif
+		}
+#endif
 		DisplayServer::get_singleton()->set_icon(icon);
 	}
 
diff --git a/main/main_builders.py b/main/main_builders.py
index 63d0bb2..0b347ca 100644
--- a/main/main_builders.py
+++ b/main/main_builders.py
@@ -23,11 +23,12 @@ def make_splash_editor(target, source, env):
 
     with methods.generated_wrapper(str(target[0])) as file:
         # The editor splash background color is taken from the default editor theme's background color.
+        # Joinery: #202123, the dark surface of Joinery's theme and of its icon's square.
         # This helps achieve a visually "smoother" transition between the splash screen and the editor.
         file.write(f"""\
 #include "core/math/color.h"
 
-static const Color boot_splash_editor_bg_color = Color(0.125, 0.145, 0.192);
+static const Color boot_splash_editor_bg_color = Color(0.125, 0.129, 0.137);
 inline constexpr const unsigned char boot_splash_editor_png[] = {{
 {methods.format_buffer(buffer, 1)}
 }};
@@ -44,3 +45,21 @@ inline constexpr const unsigned char app_icon_png[] = {{
 {methods.format_buffer(buffer, 1)}
 }};
 """)
+
+
+def make_app_icon_editor(target, source, env):
+    # Joinery: the editor's window and Dock icon. macOS gets the variant drawn on
+    # Apple's icon grid (an 824-unit square in 1024) so it sits level in the Dock.
+    buffer = methods.get_buffer(str(source[0]))
+    buffer_macos = methods.get_buffer(str(source[1]))
+
+    with methods.generated_wrapper(str(target[0])) as file:
+        file.write(f"""\
+inline constexpr const unsigned char app_icon_editor_png[] = {{
+{methods.format_buffer(buffer, 1)}
+}};
+
+inline constexpr const unsigned char app_icon_editor_macos_png[] = {{
+{methods.format_buffer(buffer_macos, 1)}
+}};
+""")
