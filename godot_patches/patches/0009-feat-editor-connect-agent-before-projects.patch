+void ProjectManager::_joinery_show_connection() {
+	if (joinery_connect) {
+		main_view_container->hide();
+		joinery_connect->call("open_settings");
+		return;
+	}
+	String home = OS::get_singleton()->get_environment("JOINERY_HOME");
+	String parent = OS::get_singleton()->get_executable_path().get_base_dir();
+	for (int i = 0; home.is_empty() && i < 4; i++) {
+		if (FileAccess::exists(parent.path_join("godot_addon/joinery/agent_connect.gd"))) {
+			home = parent;
+		}
+		parent = parent.path_join("..").simplify_path();
+	}
+	if (home.is_empty()) {
+		return;
+	}
+	Ref<Script> script = ResourceLoader::load(home.path_join("godot_addon/joinery/agent_connect.gd"));
+	if (script.is_null() || !script->is_valid()) {
+		return;
+	}
+	Object *instance = ClassDB::instantiate(script->get_instance_base_type());
+	joinery_connect = Object::cast_to<Control>(instance);
+	if (!joinery_connect) {
+		memdelete(instance);
+		return;
+	}
+	joinery_connect->set_script(script);
+	joinery_connect->set("engine_home", home);
+	if (EditorSettings::get_singleton()->has_setting("joinery/agent")) {
+		joinery_connect->set("initial_agent", EditorSettings::get_singleton()->get_setting("joinery/agent"));
+	}
+	if (EditorSettings::get_singleton()->has_setting("joinery/connection")) {
+		joinery_connect->set("initial_profile", EditorSettings::get_singleton()->get_setting("joinery/connection"));
+	}
+	joinery_connect->connect(SNAME("connected"), callable_mp(this, &ProjectManager::_joinery_agent_connected));
+	main_vbox->add_child(joinery_connect);
+	main_view_container->hide();
+	joinery_home = home;
+	// The agent in use, as a chip at the end of the project list's top bar.
+	// Pressing it reopens the connect screen.
+	joinery_agent_chip = memnew(Button);
+	joinery_agent_chip->set_flat(true);
+	joinery_agent_chip->set_expand_icon(false);
+	joinery_agent_chip->set_tooltip_text(TTR("Change the agent Journeyman uses"));
+	joinery_agent_chip->connect(SceneStringName(pressed), callable_mp(this, &ProjectManager::_joinery_show_connection));
+	if (joinery_top_bar) {
+		joinery_top_bar->add_child(joinery_agent_chip);
+	} else {
+		local_projects_vb->add_child(joinery_agent_chip);
+	}
+	_joinery_update_agent_chip();
+}
+
+void ProjectManager::_joinery_update_agent_chip() {
+	if (!joinery_agent_chip) {
+		return;
+	}
+	String agent;
+	if (EditorSettings::get_singleton()->has_setting("joinery/agent")) {
+		agent = EditorSettings::get_singleton()->get_setting("joinery/agent");
+	}
+	// The same names the connect screen shows.
+	String name = agent;
+	if (agent == "claude") {
+		name = "Claude Code";
+	} else if (agent == "codex") {
+		name = "Codex";
+	} else if (agent == "gemini") {
+		name = "Gemini";
+	} else if (agent == "opencode") {
+		name = "opencode";
+	}
+	joinery_agent_chip->set_visible(!agent.is_empty());
+	joinery_agent_chip->set_text(name + String::utf8(" · ") + TTR("Change"));
+	joinery_agent_chip->set_accessibility_name(vformat(TTR("Agent: %s. Change"), name));
+
+	// The provider's mark from the addon, at the editor's icon size. A missing
+	// or unreadable file leaves the chip as text.
+	Ref<Texture2D> icon;
+	const String base = joinery_home.path_join("godot_addon/joinery/icons/providers").path_join(agent);
+	for (const String &extension : { String(".svg"), String(".png") }) {
+		if (agent.is_empty() || !FileAccess::exists(base + extension)) {
+			continue;
+		}
+		Ref<Image> image = Image::load_from_file(base + extension);
+		if (image.is_valid() && !image->is_empty()) {
+			const int size = MAX(1, (int)Math::round(16 * EDSCALE));
+			image->resize(size, size, Image::INTERPOLATE_LANCZOS);
+			icon = ImageTexture::create_from_image(image);
+		}
+		break;
+	}
+	joinery_agent_chip->set_button_icon(icon);
+}
+
+void ProjectManager::_joinery_agent_connected(const String &p_agent, const String &p_method) {
+	EditorSettings::get_singleton()->set_setting("joinery/agent", p_agent);
+	EditorSettings::get_singleton()->set_setting("joinery/auth_method", p_method);
+	String profile = joinery_connect->get("selected_profile");
+	EditorSettings::get_singleton()->set_setting("joinery/connection", profile);
+	EditorSettings::get_singleton()->save();
+	OS::get_singleton()->set_environment("JOINERY_AGENT", p_agent);
+	OS::get_singleton()->set_environment("JOINERY_MODEL_PROFILE", profile);
+	joinery_connect->hide();
+	main_view_container->show();
+	_joinery_update_agent_chip();
 }
 
