+++ b/editor/project_manager/project_dialog.h
@@ -209,6 +209,9 @@ private:
 	// Step 2: one row per app, grouped Engine / 3D / 2D / Audio. How Joinery
 	// connects to each app sits under one collapsed Advanced disclosure.
 	VBoxContainer *joinery_container = nullptr;
+	// How many older versions the new project keeps (`joinery history`).
+	VBoxContainer *joinery_history_box = nullptr;
+	OptionButton *joinery_history_picker = nullptr;
 	Control *joinery_loading_row = nullptr;
 	ProgressBar *joinery_loading_bar = nullptr;
 	VBoxContainer *joinery_tool_list = nullptr;
@@ -308,6 +311,7 @@ private:
 	String joinery_job_features;
 	String joinery_job_steam_id;
 	String joinery_job_connect;
+	String joinery_job_history;
 	String joinery_job_brief;
 	Ref<FileAccess> joinery_choices_file;
 	Ref<ButtonGroup> renderer_button_group;
