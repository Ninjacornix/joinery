+// One disclosure look everywhere ("Advanced", "Details"): the chevron first,
+// its glyph on the content's left edge, then the label in regular weight.
+// The editor's tree arrows sit in the middle of a padded square, so the
+// padding is cut off; both arrows get one width so the label never moves
+// when the disclosure opens.
 void ProjectDialog::_joinery_set_disclosure(Button *p_button, bool p_open) {
-	if (p_button) {
-		p_button->set_button_icon(get_editor_theme_icon(p_open ? SNAME("GuiTreeArrowDown") : SNAME("GuiTreeArrowRight")));
+	if (!p_button) {
+		return;
+	}
+	const Ref<Texture2D> closed = get_editor_theme_icon(SNAME("GuiTreeArrowRight"));
+	const Ref<Texture2D> open = get_editor_theme_icon(SNAME("GuiTreeArrowDown"));
+	const Ref<Texture2D> icon = p_open ? open : closed;
+	Ref<Texture2D> shown = icon;
+	if (icon.is_valid() && closed.is_valid() && open.is_valid()) {
+		const Ref<Image> image = icon->get_image();
+		const Ref<Image> image_closed = closed->get_image();
+		const Ref<Image> image_open = open->get_image();
+		if (image.is_valid() && image_closed.is_valid() && image_open.is_valid()) {
+			const Rect2i used = image->get_used_rect();
+			const int width = MAX(image_closed->get_used_rect().size.x, image_open->get_used_rect().size.x);
+			const float scale = icon->get_width() / (float)MAX(1, image->get_width());
+			if (used.size.x > 0 && width > 0) {
+				Ref<AtlasTexture> trimmed;
+				trimmed.instantiate();
+				trimmed->set_atlas(icon);
+				const float x = used.position.x * scale;
+				trimmed->set_region(Rect2(x, 0, MIN(width * scale, icon->get_width() - x), icon->get_height()));
+				shown = trimmed;
+			}
+		}
 	}
+	p_button->set_button_icon(shown);
+	p_button->set_theme_type_variation(SNAME("JoineryTextButton"));
 }
 
