+// The header's side insets are the page panel's content margins, so the
+// wordmark starts on the same left edge as everything inside the page.
+void ProjectManager::_joinery_fit_header() {
+	if (!joinery_header || !main_view_container) {
+		return;
+	}
+	Ref<StyleBox> page = main_view_container->get_theme_stylebox(SceneStringName(panel));
+	const int left = page.is_valid() ? (int)page->get_margin(SIDE_LEFT) : 0;
+	const int right = page.is_valid() ? (int)page->get_margin(SIDE_RIGHT) : 0;
+	joinery_header->add_theme_constant_override(SNAME("margin_left"), left);
+	joinery_header->add_theme_constant_override(SNAME("margin_right"), right);
+}
