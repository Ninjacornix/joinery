+
+static String _joinery_catalog_failure(const String &p_output, int p_exit) {
+	if (_joinery_helper_missing(p_output, p_exit)) {
+		return TTR("Joinery is missing a helper it needs to list your apps. Install it (see Details), then retry, or create a plain Godot project.");
 	}
