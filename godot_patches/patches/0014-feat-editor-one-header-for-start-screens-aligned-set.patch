 }
 
+// The Details text: the tool's name and where to get it go here, not in the
+// sentence, followed by whatever the command printed.
+static String _joinery_catalog_details(const String &p_output, int p_exit, const String &p_reason) {
+	const String raw = p_output.is_empty() ? p_reason : p_output;
+	if (!_joinery_helper_missing(p_output, p_exit)) {
+		return raw;
+	}
+	const String how = TTR("The helper is uv. Install it from https://docs.astral.sh/uv/ and run Joinery's installer again.");
+	return raw.is_empty() ? how : how + "\n\n" + raw;
+}
