+	for (Control *c : { (Control *)project_name, (Control *)joinery_folder_change, (Control *)joinery_cancel, (Control *)joinery_back, (Control *)joinery_next, (Control *)joinery_banner_retry, (Control *)joinery_banner_plain, (Control *)joinery_advanced, (Control *)joinery_apps_advanced, (Control *)joinery_details_button, (Control *)joinery_banner_details_button }) {
