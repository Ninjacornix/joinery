+// What went wrong with the app list, in words a newcomer can act on. The raw
+// output goes under Details, never in the sentence.
+static String _joinery_catalog_failure(const String &p_output, int p_exit) {
+	const String lower = p_output.to_lower();
+	if (p_exit < 0 || p_exit == 127 || lower.contains("uv: command not found") || lower.contains("uv: not found") || lower.contains("'uv' is not recognized")) {
+		return TTR("Joinery couldn't find uv, which it needs to list your apps. Install uv, then retry, or create a plain Godot project.");
+	}
+	return TTR("Joinery couldn't list your apps. Retry, or create a plain Godot project.");
+}
+
+// A connector's name for people: "hi-godot/godot-ai" reads "Godot AI". The
+// raw id stays in the tooltip for anyone who needs it.
+static String _joinery_connector_name(const String &p_label) {
+	const String repo = p_label.get_slicec('/', p_label.get_slice_count("/") - 1);
+	String out;
+	const Vector<String> words = repo.replace("_", "-").split("-", false);
+	for (const String &word : words) {
+		const String lower = word.to_lower();
+		String shown;
+		if (lower == "ai" || lower == "mcp" || lower == "api" || lower == "gimp" || lower == "midi" || lower == "ui") {
+			shown = word.to_upper();
+		} else {
+			shown = word.substr(0, 1).to_upper() + word.substr(1);
+		}
+		out += (out.is_empty() ? String() : String(" ")) + shown;
+	}
+	return out.is_empty() ? p_label : out;
+}
