+			p_theme->set_color(name, "JoineryFieldPicker", text);
+		}
+		p_theme->set_color("font_disabled_color", "JoineryFieldPicker", text_faint);
+	}
+
+	// An indeterminate progress bar the eye can find: accent on a visible track.
+	p_theme->set_type_variation("JoineryProgress", "ProgressBar");
+	{
+		Ref<StyleBoxFlat> track;
+		track.instantiate();
+		track->set_bg_color(border_subtle);
+		track->set_corner_radius_all(2 * EDSCALE);
+		track->set_content_margin_all(0);
+		Ref<StyleBoxFlat> fill = track->duplicate();
+		fill->set_bg_color(accent);
+		p_theme->set_stylebox("background", "JoineryProgress", track);
+		p_theme->set_stylebox("fill", "JoineryProgress", fill);
+	}
+
+	// The wordmark in the Project Manager: display size, bold, in the plain
+	// font colour, drawn as a flat button so it opens About. Flush left, so it
+	// shares the page's left edge with the line and the bar under it.
+	p_theme->set_type_variation("JoineryWordmark", "JoineryTextButton");
 	p_theme->set_font_size(SceneStringName(font_size), "JoineryWordmark", (int)Math::round(body * 1.7));
 	p_theme->set_font(SceneStringName(font), "JoineryWordmark", bold);
 }
