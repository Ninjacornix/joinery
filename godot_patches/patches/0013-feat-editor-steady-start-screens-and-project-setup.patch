-// The scroll frame reaches past the column by the focus ring on every side,
-// and on the trailing side also by the scrollbar's reserved gutter. The inner
-// margin takes the ring back, so the fields keep the header's left and right
-// edges whether or not the page scrolls.
+// Every app's blurb starts at one x: each name column is as wide as the
+// widest name, so the list reads as two columns, not a ragged middle edge.
+void ProjectDialog::_joinery_align_names() {
+	float widest = 0;
+	for (CheckBox *box : joinery_boxes) {
+		box->set_custom_minimum_size(Size2(0, box->get_custom_minimum_size().y));
+		widest = MAX(widest, box->get_combined_minimum_size().x);
+	}
+	for (CheckBox *box : joinery_boxes) {
+		box->set_custom_minimum_size(Size2(widest, box->get_custom_minimum_size().y));
+	}
+}
+
+// The page scrolls inside the column, never past it. The dialog's outer
+// margin is one ring narrower on the leading side; the page's inner margin
+// gives that ring back (room for focus rings), and so do the header and
+// footer frames, so all three share one left edge. The scrollbar stays inside
+// the column's right edge, and the page ends with a section gap so its last
+// line never sits against the footer rule.
 void ProjectDialog::_joinery_fit_scroll() {
 	if (!joinery_scroll_frame || !joinery_scroll || !joinery_scroll_inner) {
 		return;
 	}
 	const int ring = _joinery_space(1);
-	int gutter = joinery_scroll->get_theme_constant(SNAME("scrollbar_h_separation"));
-	if (joinery_scroll->get_v_scroll_bar()) {
-		gutter += joinery_scroll->get_v_scroll_bar()->get_combined_minimum_size().x;
-	}
-	const Ref<StyleBox> panel = joinery_scroll->get_theme_stylebox(SceneStringName(panel));
-	if (panel.is_valid()) {
-		gutter += panel->get_margin(SIDE_RIGHT);
-	}
-	joinery_scroll_frame->add_theme_constant_override(SNAME("margin_left"), -ring);
-	joinery_scroll_frame->add_theme_constant_override(SNAME("margin_top"), -ring);
-	joinery_scroll_frame->add_theme_constant_override(SNAME("margin_bottom"), -ring);
-	joinery_scroll_frame->add_theme_constant_override(SNAME("margin_right"), -(ring + gutter));
 	for (const StringName &side : { SNAME("margin_left"), SNAME("margin_right"), SNAME("margin_top"), SNAME("margin_bottom") }) {
-		joinery_scroll_inner->add_theme_constant_override(side, ring);
+		joinery_scroll_frame->add_theme_constant_override(side, 0);
+	}
+	joinery_scroll_inner->add_theme_constant_override(SNAME("margin_left"), ring);
+	joinery_scroll_inner->add_theme_constant_override(SNAME("margin_right"), ring);
+	joinery_scroll_inner->add_theme_constant_override(SNAME("margin_top"), ring);
+	joinery_scroll_inner->add_theme_constant_override(SNAME("margin_bottom"), _joinery_space(5));
+	for (MarginContainer *frame : { joinery_header_frame, joinery_footer_frame }) {
+		if (frame) {
+			frame->add_theme_constant_override(SNAME("margin_left"), ring);
+		}
 	}
 }
 
