+// OS::execute captures output through a shell on Unix, with each argument in
+// plain double quotes. A path holding one of these would end the quotes or
+// run as a command, so such a path is refused rather than passed.
+static bool _joinery_shell_safe(const String &p_text) {
+#ifdef WINDOWS_ENABLED
+	return !p_text.contains_char('"');
+#else
+	for (const char32_t c : { U'"', U'$', U'`', U'\\' }) {
+		if (p_text.contains_char(c)) {
+			return false;
+		}
+	}
+	return true;
+#endif
+}
