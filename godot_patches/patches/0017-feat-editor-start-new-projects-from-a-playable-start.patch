+// Digits only, or empty to add it later. Anything else is named under the
+// field and keeps Next from moving on.
+bool ProjectDialog::_joinery_steam_id_valid() const {
+	if (!joinery_steam_app_id || !_joinery_feature_on("steam")) {
+		return true;
+	}
+	const String text = joinery_steam_app_id->get_text().strip_edges();
+	if (text.length() > 10) {
+		return false;
+	}
+	for (int i = 0; i < text.length(); i++) {
+		if (!is_digit(text[i])) {
+			return false;
+		}
+	}
+	return true;
+}
