+// Joinery: a switch track and knob at p_progress (0 off, 1 on), anti-aliased.
+// The same drawing as the addon's ui_theme_build.switch_texture, so a switch in
+// the Project Manager matches one in the sidebar's settings.
+static Ref<ImageTexture> _joinery_switch_texture(int p_width, int p_height, float p_progress, const Color &p_track, const Color &p_knob, float p_alpha) {
+	Ref<Image> image = Image::create_empty(p_width, p_height, false, Image::FORMAT_RGBA8);
+	const float half = p_height / 2.0;
+	const float inset = MAX(2.0f, Math::round(p_height * 0.14f));
+	const float knob_r = half - inset;
+	const float x = Math::lerp(inset + knob_r, p_width - inset - knob_r, p_progress);
+	const auto capsule = [](const Vector2 &p_point, const Vector2 &p_center, float p_half_length, float p_radius) {
+		const float dx = MAX(Math::abs(p_point.x - p_center.x) - p_half_length, 0.0f);
+		return Vector2(dx, p_point.y - p_center.y).length() - p_radius;
+	};
+	for (int py = 0; py < p_height; py++) {
+		for (int px = 0; px < p_width; px++) {
+			const Vector2 point(px + 0.5, py + 0.5);
+			const float track_d = capsule(point, Vector2(p_width / 2.0, half), p_width / 2.0 - half, half);
+			const float knob_d = capsule(point, Vector2(x, half), 0.0, knob_r);
+			const Color under(p_track, p_track.a * p_alpha * CLAMP(0.5f - track_d, 0.0f, 1.0f));
+			const Color over(p_knob, p_knob.a * p_alpha * CLAMP(0.5f - knob_d, 0.0f, 1.0f));
+			image->set_pixel(px, py, under.blend(over));
+		}
+	}
+	return ImageTexture::create_from_image(image);
+}
