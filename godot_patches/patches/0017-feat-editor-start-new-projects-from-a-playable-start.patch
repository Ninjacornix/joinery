+		p_canvas->draw_rect(Rect2(0, h * 0.80, w, h * 0.20), tone(0.20));
+		if (p_view != "empty") {
+			p_canvas->draw_rect(Rect2(w * 0.12, h * 0.58, w * 0.22, h * 0.06), tone(0.30));
