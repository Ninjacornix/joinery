+
+// What Create will do, in one line: the files it writes, their licences and
+// whether it uses the network.
+void ProjectDialog::_joinery_update_summary() {
+	if (!joinery_summary) {
+		return;
+	}
+	const Dictionary blueprint = _joinery_current_blueprint();
+	if (blueprint.is_empty()) {
+		joinery_summary->set_text(String());
+		return;
+	}
+	const int own_files = blueprint.get("files", 0);
+	int feature_files = 0;
+	Vector<String> licences;
+	const String own = blueprint.get("licence", "MIT");
+	licences.push_back(own);
+	for (int i = 0; i < joinery_feature_switches.size(); i++) {
+		if (!joinery_feature_switches[i]->is_pressed()) {
+			continue;
+		}
+		const Dictionary feature = joinery_feature_data[i];
+		feature_files += _joinery_adds_files(feature.get("adds", Variant()));
+		Array sources = feature.get("external", Array());
+		sources.push_front(feature);
+		for (int s = 0; s < sources.size(); s++) {
+			const Dictionary source = sources[s];
+			const String licence = source.get("licence", "");
+			if (!licence.is_empty() && !licences.has(licence)) {
+				licences.push_back(licence);
+			}
+		}
+	}
+	String what;
+	if (own_files > 0) {
+		what = vformat(TTR("Creates %d files"), own_files + feature_files);
+	} else if (feature_files > 0) {
+		what = vformat(TTR("Starts from %s and adds %d files"), String(blueprint.get("name", "")), feature_files);
+	} else {
+		what = vformat(TTR("Starts from %s"), String(blueprint.get("name", "")));
+	}
+	const String licence_text = vformat(licences.size() == 1 ? TTR("Licence: %s") : TTR("Licences: %s"), String(", ").join(licences));
+	const String network = _joinery_feature_on("steam") ? TTR("Network: downloads GodotSteam") : TTR("Network: none");
+	joinery_summary->set_text(what + String::utf8(" · ") + licence_text + String::utf8(" · ") + network);
+	joinery_summary->set_tooltip_text(joinery_summary->get_text());
+}
