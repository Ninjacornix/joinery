+// A card's contents only show it; the card's button underneath takes every
+// click, so the whole card is one target.
+static void _joinery_ignore_mouse(Node *p_node) {
+	Control *control = Object::cast_to<Control>(p_node);
+	if (control) {
+		control->set_mouse_filter(Control::MOUSE_FILTER_IGNORE);
+	}
+	for (int i = 0; i < p_node->get_child_count(); i++) {
+		_joinery_ignore_mouse(p_node->get_child(i));
+	}
