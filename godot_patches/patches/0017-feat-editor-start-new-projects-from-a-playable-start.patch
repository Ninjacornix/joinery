+// Features.
+
+// The starting point's own rows from the CLI. A CLI from before those rows
+// existed sends only the catalogue, so the rows are derived from it with the
+// same meaning: supported means available, the defaults start on.
+Array ProjectDialog::_joinery_blueprint_features() const {
+	const Dictionary blueprint = _joinery_current_blueprint();
+	if (blueprint.get("features", Variant()).get_type() == Variant::ARRAY) {
+		return blueprint["features"];
+	}
+	Array out;
+	const Array supported = blueprint.get("features_supported", Array());
+	const Array defaults = blueprint.get("default_features", Array());
+	for (int i = 0; i < joinery_feature_catalog.size(); i++) {
+		const Dictionary feature = joinery_feature_catalog[i];
+		Dictionary row = feature.duplicate();
+		const String id = feature.get("id", "");
+		row["default"] = defaults.has(id);
+		row["available"] = supported.has(id);
+		if (!supported.has(id)) {
+			row["reason"] = vformat(TTR("Not available for %s."), String(blueprint.get("name", "")));
+		}
+		out.push_back(row);
+	}
+	return out;
+}
