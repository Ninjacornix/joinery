+int ProjectDialog::_joinery_feature_index(const String &p_id) const {
+	for (int i = 0; i < joinery_feature_data.size(); i++) {
+		if (String(joinery_feature_data[i].get("id", "")) == p_id) {
+			return i;
+		}
+	}
+	return -1;
+}
