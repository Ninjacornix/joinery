+// Runs one `joinery` command through uv on the worker thread.
+bool ProjectDialog::_joinery_uv(const String &p_home, const Vector<String> &p_args, String &r_output) {
+	for (const String &arg : p_args) {
+		if (!_joinery_shell_safe(arg) || !_joinery_shell_safe(p_home)) {
+			r_output = "Refused to pass a value with quotes, $, ` or \\ to the shell: " + arg;
+			return false;
+		}
+	}
 	List<String> args;
 	args.push_back("run");
 	args.push_back("--project");
-	args.push_back(home);
+	args.push_back(p_home);
 	args.push_back("joinery");
-	args.push_back("tools");
-	args.push_back("--json");
+	for (const String &arg : p_args) {
+		args.push_back(arg);
+	}
 	int exit_code = -1;
-	if (OS::get_singleton()->execute("uv", args, &self->joinery_load_output[0], &exit_code, true) != OK) {
-		exit_code = -1;
+	if (OS::get_singleton()->execute("uv", args, &r_output, &exit_code, true) != OK) {
+		r_output = "uv could not be started.\n" + r_output;
+		return false;
 	}
-	self->joinery_load_exit[0] = exit_code;
+	return exit_code == 0;
+}
 
