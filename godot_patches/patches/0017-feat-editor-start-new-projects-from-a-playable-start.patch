+// A switch the user sets wins. What it needs turns on, what it clashes with
+// turns off, and whatever needed something now off turns off too; every row
+// Joinery changed says why, in one line under it.
+void ProjectDialog::_joinery_feature_toggled(bool p_on, int p_row) {
+	if (joinery_resolving_features || p_row < 0 || p_row >= joinery_feature_switches.size()) {
+		return;
+	}
+	joinery_resolving_features = true;
+	const int count = joinery_feature_switches.size();
+	const auto id_of = [this](int p_index) {
+		return String(joinery_feature_data[p_index].get("id", ""));
+	};
+	const auto name_of = [this](int p_index) {
+		return String(joinery_feature_data[p_index].get("name", ""));
+	};
+	const auto list_of = [this](int p_index, const String &p_key) {
+		return Array(joinery_feature_data[p_index].get(p_key, Array()));
+	};
+	const auto note = [this](int p_index, const String &p_text) {
+		joinery_feature_reasons[p_index]->set_text(p_text);
+		joinery_feature_reasons[p_index]->show();
+	};
+	joinery_feature_reasons[p_row]->set_text(String());
+	joinery_feature_reasons[p_row]->hide();
+
+	if (p_on) {
+		Vector<int> todo;
+		todo.push_back(p_row);
+		while (!todo.is_empty()) {
+			const int row = todo[todo.size() - 1];
+			todo.remove_at(todo.size() - 1);
+			const Array needs = list_of(row, "requires");
+			for (int n = 0; n < needs.size(); n++) {
+				const int other = _joinery_feature_index(needs[n]);
+				if (other >= 0 && !joinery_feature_switches[other]->is_pressed() && !joinery_feature_switches[other]->is_disabled()) {
+					joinery_feature_switches[other]->set_pressed_no_signal(true);
+					note(other, vformat(TTR("Turned on: %s needs it."), name_of(row)));
+					todo.push_back(other);
+				}
+			}
+		}
+	}
+	bool changed = true;
+	while (changed) {
+		changed = false;
+		for (int k = 0; k < count; k++) {
+			if (!joinery_feature_switches[k]->is_pressed()) {
+				continue;
+			}
+			for (int m = 0; m < count; m++) {
+				if (m == k || !joinery_feature_switches[m]->is_pressed() || !joinery_feature_switches[k]->is_pressed()) {
+					continue;
+				}
+				if (list_of(k, "conflicts").has(id_of(m)) || list_of(m, "conflicts").has(id_of(k))) {
+					// The switch just set stays; otherwise the later row gives way.
+					const int loser = m == p_row ? k : (k == p_row ? m : MAX(k, m));
+					const int winner = loser == k ? m : k;
+					joinery_feature_switches[loser]->set_pressed_no_signal(false);
+					note(loser, vformat(TTR("Turned off: it doesn't work with %s."), name_of(winner)));
+					changed = true;
+				}
+			}
+			if (!joinery_feature_switches[k]->is_pressed()) {
+				continue;
+			}
+			const Array needs = list_of(k, "requires");
+			for (int n = 0; n < needs.size(); n++) {
+				const int other = _joinery_feature_index(needs[n]);
+				if (other < 0 || !joinery_feature_switches[other]->is_pressed()) {
+					joinery_feature_switches[k]->set_pressed_no_signal(false);
+					note(k, vformat(TTR("Turned off: it needs %s."), other >= 0 ? name_of(other) : String(needs[n])));
+					changed = true;
+					break;
+				}
+			}
+		}
+	}
+	joinery_resolving_features = false;
+	_joinery_update_steam();
+	_joinery_update_summary();
+	_update_ok_button();
+}
