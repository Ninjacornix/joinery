+
+// The files a feature writes, by count. `adds` lists them with the settings
+// and autoloads it merges; a file's .uid sidecar is not counted separately.
+static int _joinery_adds_files(const Variant &p_adds) {
+	if (p_adds.get_type() != Variant::DICTIONARY) {
+		return 0;
+	}
+	const Array files = Dictionary(p_adds).get("files", Array());
+	int count = 0;
+	for (int i = 0; i < files.size(); i++) {
+		count += String(files[i]).ends_with(".uid") ? 0 : 1;
+	}
+	return count;
+}
+
+// "Adds: 5 files · Controller · 2 settings": what a feature puts in the
+// project, from the CLI's `adds`. The autoloads are named, because they are
+// what game code calls.
+static String _joinery_adds_text(const Variant &p_adds) {
+	if (p_adds.get_type() == Variant::STRING) {
+		return p_adds;
+	}
+	if (p_adds.get_type() == Variant::ARRAY) {
+		String out;
+		const Array items = p_adds;
+		for (int i = 0; i < items.size(); i++) {
+			out += (out.is_empty() ? String() : String(", ")) + String(items[i]);
+		}
+		return out;
+	}
+	if (p_adds.get_type() != Variant::DICTIONARY) {
+		return String();
+	}
+	const Dictionary adds = p_adds;
+	Vector<String> parts;
+	const int files = _joinery_adds_files(p_adds);
+	if (files > 0) {
+		parts.push_back(vformat(files == 1 ? TTR("%d file") : TTR("%d files"), files));
+	}
+	const Array settings = adds.get("settings", Array());
+	String autoloads;
+	int other = 0;
+	for (int i = 0; i < settings.size(); i++) {
+		const String key = settings[i];
+		if (key.begins_with("autoload/")) {
+			autoloads += (autoloads.is_empty() ? String() : String(", ")) + key.trim_prefix("autoload/");
+		} else {
+			other++;
+		}
+	}
+	if (!autoloads.is_empty()) {
+		parts.push_back(autoloads);
+	}
+	if (other > 0) {
+		parts.push_back(vformat(other == 1 ? TTR("%d setting") : TTR("%d settings"), other));
+	}
+	return String::utf8(" · ").join(parts);
+}
