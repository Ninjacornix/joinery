+// The capture of the starting point running, made by its recipe. Without one
+// yet, a preview drawn in code from what the starting point is.
+Control *ProjectDialog::_joinery_make_preview(const Dictionary &p_blueprint) {
+	const Variant capture = p_blueprint.get("capture", Variant());
+	if (capture.get_type() == Variant::STRING && !String(capture).is_empty()) {
+		String path = capture;
+		if (path.is_relative_path()) {
+			path = joinery_home_cache.path_join(path);
+		}
+		const Ref<Image> image = Image::load_from_file(path);
+		if (image.is_valid() && !image->is_empty()) {
+			TextureRect *shot = memnew(TextureRect);
+			shot->set_texture(ImageTexture::create_from_image(image));
+			shot->set_expand_mode(TextureRect::EXPAND_IGNORE_SIZE);
+			shot->set_stretch_mode(TextureRect::STRETCH_KEEP_ASPECT_COVERED);
+			return shot;
+		}
+	}
+	const String dimension = p_blueprint.get("dimension", "");
+	const Dictionary hooks = p_blueprint.get("hooks", Dictionary());
+	const Dictionary brief = p_blueprint.get("brief", Dictionary());
+	const String camera = String(brief.get("camera", "")).to_lower();
+	String view = "side";
+	if (hooks.has("player_scene") && String(hooks["player_scene"]).is_empty()) {
+		view = "empty";
+	} else if (camera.contains("overhead") || camera.contains("top-down") || camera.contains("from above")) {
+		view = "top";
+	}
+	Control *canvas = memnew(Control);
+	canvas->connect(SceneStringName(draw), callable_mp(this, &ProjectDialog::_joinery_draw_preview).bind(canvas, dimension, view, String(p_blueprint.get("icon", ""))));
+	return canvas;
+}
