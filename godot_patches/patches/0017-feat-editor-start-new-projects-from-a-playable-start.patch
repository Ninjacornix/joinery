+// Brief and art direction.
+
+void ProjectDialog::_joinery_select_preset() {
+	joinery_preset_box->set_visible(joinery_preset_picker->get_item_count() > 0 && !joinery_bible_keys.is_empty());
+	const String blueprint_id = _joinery_current_blueprint().get("id", "");
+	if (blueprint_id == joinery_preset_for) {
+		return;
+	}
+	joinery_preset_for = blueprint_id;
+	const String preset = _joinery_current_blueprint().get("bible_preset", "none");
+	for (int i = 0; i < joinery_preset_picker->get_item_count(); i++) {
+		if (String(joinery_preset_picker->get_item_metadata(i)) == preset) {
+			joinery_preset_picker->select(i);
+		}
+	}
+}
+
+// The pitch comes from step 1's sentence and the rest from the starting
+// point's brief defaults. A field the user has typed in is never replaced.
+void ProjectDialog::_joinery_fill_brief_defaults() {
+	const Dictionary defaults = _joinery_current_blueprint().get("brief", Dictionary());
+	for (int i = 0; i < joinery_brief_inputs.size() && i < joinery_brief_keys.size(); i++) {
+		const String key = joinery_brief_keys[i];
+		String value;
+		if (key == "pitch") {
+			value = joinery_pitch->get_text().strip_edges();
+		}
+		if (value.is_empty()) {
+			const Variant fallback = defaults.get(key, Variant());
+			if (fallback.get_type() == Variant::STRING) {
+				value = fallback;
+			} else if (fallback.get_type() == Variant::ARRAY) {
+				const Array items = fallback;
+				for (int a = 0; a < items.size(); a++) {
+					value += (value.is_empty() ? String() : String(", ")) + String(items[a]);
+				}
+			}
+		}
+		LineEdit *line = Object::cast_to<LineEdit>(joinery_brief_inputs[i]);
+		TextEdit *box = Object::cast_to<TextEdit>(joinery_brief_inputs[i]);
+		const String current = line ? line->get_text() : (box ? box->get_text() : String());
+		const String last = joinery_brief_filled.get(key, "");
+		if (current.is_empty() || current == last) {
+			if (line) {
+				line->set_text(value);
+			} else if (box) {
+				box->set_text(value);
+			}
+			joinery_brief_filled[key] = value;
+		}
+	}
+}
+
+Dictionary ProjectDialog::_joinery_field_values(const Vector<Control *> &p_inputs, const Vector<String> &p_keys) const {
+	Dictionary values;
+	for (int i = 0; i < p_inputs.size() && i < p_keys.size(); i++) {
+		const TextEdit *box = Object::cast_to<TextEdit>(p_inputs[i]);
+		const LineEdit *line = Object::cast_to<LineEdit>(p_inputs[i]);
+		if (box) {
+			values[p_keys[i]] = box->get_text();
+		} else if (line) {
+			values[p_keys[i]] = line->get_text();
+		}
+	}
+	return values;
+}
+
+// project.godot, the icon and .editorconfig, written by the stock code before
+// the worker starts: `joinery game apply` merges the starting point's settings
+// into project.godot, so it has to exist first and must not be rewritten
+// after. Returns false with the reason in msg.
+bool ProjectDialog::_joinery_write_project_file() {
+	invalid_state_flags.clear_flag(INVALID_STATE_FLAG_PATH_INPUT);
+	is_folder_empty = true;
+	joinery_files_ready = true;
+	joinery_write_only = true;
+	ok_pressed();
+	joinery_write_only = false;
+	joinery_files_ready = false;
+	const bool written = !invalid_state_flags.has_flag(INVALID_STATE_FLAG_PATH_INPUT) && FileAccess::exists(project_path->get_text().path_join("project.godot"));
+	invalid_state_flags.clear_flag(INVALID_STATE_FLAG_PATH_INPUT);
+	return written;
+}
