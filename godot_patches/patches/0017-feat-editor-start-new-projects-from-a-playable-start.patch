+// Built when step 2 opens for a starting point it wasn't built for, so going
+// back and forth keeps every switch the user set.
+void ProjectDialog::_joinery_build_features() {
+	if (!joinery_blueprints_ready || joinery_blueprint < 0) {
+		return;
+	}
+	const String blueprint_id = _joinery_current_blueprint().get("id", "");
+	if (blueprint_id == joinery_features_for) {
+		return;
+	}
+	joinery_features_for = blueprint_id;
+	while (joinery_feature_rows->get_child_count() > 0) {
+		Node *child = joinery_feature_rows->get_child(0);
+		joinery_feature_rows->remove_child(child);
+		memdelete(child);
+	}
+	joinery_feature_switches.clear();
+	joinery_feature_reasons.clear();
+	joinery_feature_data.clear();
+	joinery_steam_box = nullptr;
+	joinery_steam_app_id = nullptr;
+	joinery_steam_error = nullptr;
+	joinery_connect_box = nullptr;
+	joinery_connect_steam = nullptr;
+	joinery_connect_direct = nullptr;
+
+	const int control_height = _joinery_control_h(2.5);
+	const Array features = _joinery_blueprint_features();
+	for (int i = 0; i < features.size(); i++) {
+		const Dictionary feature = features[i];
+		const String id = feature.get("id", "");
+		const String name = feature.get("name", id);
+		const bool available = feature.get("available", true);
+		const String reason = feature.get("reason", "");
+
+		VBoxContainer *row = memnew(VBoxContainer);
+		row->add_theme_constant_override("separation", _joinery_space(1));
+		joinery_feature_rows->add_child(row);
+
+		CheckButton *toggle = memnew(CheckButton);
+		toggle->set_theme_type_variation(SNAME("JoinerySwitch"));
+		toggle->set_text(name);
+		toggle->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+		toggle->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+		toggle->set_accessibility_name(name);
+		toggle->set_pressed(available && bool(feature.get("default", false)));
+		toggle->set_disabled(!available);
+		row->add_child(toggle);
+
+		const String summary = feature.get("summary", "");
+		if (!summary.is_empty()) {
+			Label *blurb = _joinery_caption(summary);
+			blurb->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+			row->add_child(blurb);
+		}
+		const String adds_text = _joinery_adds_text(feature.get("adds", Variant()));
+		if (!adds_text.is_empty()) {
+			Label *adds_line = _joinery_caption(vformat(TTR("Adds: %s"), adds_text));
+			adds_line->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+			row->add_child(adds_line);
+		}
+		// Why a switch can't be used, or why Joinery just changed it.
+		Label *note = _joinery_caption(available ? String() : reason);
+		note->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+		note->set_visible(!available && !reason.is_empty());
+		row->add_child(note);
+
+		if (id == "steam") {
+			// Steam's own questions, inline, with no extra step.
+			MarginContainer *steam_frame = memnew(MarginContainer);
+			steam_frame->add_theme_constant_override("margin_top", _joinery_space(2));
+			row->add_child(steam_frame);
+			joinery_steam_box = memnew(VBoxContainer);
+			joinery_steam_box->add_theme_constant_override("separation", _joinery_space(1));
+			steam_frame->add_child(joinery_steam_box);
+			Label *id_label = memnew(Label);
+			id_label->set_theme_type_variation(SNAME("JoineryLabel"));
+			id_label->set_text(TTR("Steam app ID"));
+			id_label->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+			joinery_steam_box->add_child(id_label);
+			joinery_steam_app_id = memnew(LineEdit);
+			joinery_steam_app_id->set_theme_type_variation(SNAME("JoineryField"));
+			joinery_steam_app_id->set_custom_minimum_size(Size2(0, control_height));
+			joinery_steam_app_id->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+			joinery_steam_app_id->set_placeholder(TTR("e.g. 480"));
+			joinery_steam_app_id->set_accessibility_name(TTR("Steam app ID"));
+			joinery_steam_app_id->set_virtual_keyboard_type(LineEdit::KEYBOARD_TYPE_NUMBER);
+			joinery_steam_app_id->connect(SceneStringName(text_changed), callable_mp(this, &ProjectDialog::_joinery_steam_id_changed));
+			joinery_steam_app_id->connect(SceneStringName(text_submitted), callable_mp(this, &ProjectDialog::_joinery_next_pressed).unbind(1));
+			joinery_steam_box->add_child(joinery_steam_app_id);
+			joinery_steam_error = memnew(Label);
+			joinery_steam_error->set_theme_type_variation(SNAME("JoineryError"));
+			joinery_steam_error->set_autowrap_mode(TextServer::AUTOWRAP_WORD_SMART);
+			joinery_steam_error->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+			joinery_steam_error->set_focus_mode(Control::FOCUS_ACCESSIBILITY);
+			joinery_steam_error->set_accessibility_live(AccessibilityServerEnums::LIVE_POLITE);
+			joinery_steam_error->hide();
+			joinery_steam_box->add_child(joinery_steam_error);
+			joinery_steam_box->add_child(_joinery_caption(TTR("From your Steamworks account. Leave empty to add it later.")));
+			joinery_steam_box->add_child(_joinery_caption(TTR("When you create the project, Joinery downloads a checked copy of GodotSteam, the add-on that connects your game to Steam.")));
+
+			joinery_connect_box = memnew(VBoxContainer);
+			joinery_connect_box->add_theme_constant_override("separation", _joinery_space(1));
+			MarginContainer *connect_frame = memnew(MarginContainer);
+			connect_frame->add_theme_constant_override("margin_top", _joinery_space(2));
+			connect_frame->add_child(joinery_connect_box);
+			joinery_steam_box->add_child(connect_frame);
+			Label *connect_label = memnew(Label);
+			connect_label->set_theme_type_variation(SNAME("JoineryLabel"));
+			connect_label->set_text(TTR("Connect players through:"));
+			connect_label->set_auto_translate_mode(AUTO_TRANSLATE_MODE_DISABLED);
+			joinery_connect_box->add_child(connect_label);
+			HBoxContainer *choices = memnew(HBoxContainer);
+			choices->add_theme_constant_override("separation", _joinery_space(5));
+			joinery_connect_box->add_child(choices);
+			joinery_connect_steam = memnew(CheckBox);
+			joinery_connect_steam->set_theme_type_variation(SNAME("JoineryCheckBox"));
+			joinery_connect_steam->set_text(TTR("Steam"));
+			joinery_connect_steam->set_button_group(joinery_connect_group);
+			joinery_connect_steam->set_pressed(true);
+			choices->add_child(joinery_connect_steam);
+			joinery_connect_direct = memnew(CheckBox);
+			joinery_connect_direct->set_theme_type_variation(SNAME("JoineryCheckBox"));
+			joinery_connect_direct->set_text(TTR("Direct (IP)"));
+			joinery_connect_direct->set_button_group(joinery_connect_group);
+			choices->add_child(joinery_connect_direct);
+		}
+
+		joinery_feature_switches.push_back(toggle);
+		joinery_feature_reasons.push_back(note);
+		joinery_feature_data.push_back(feature);
+		toggle->connect(SceneStringName(toggled), callable_mp(this, &ProjectDialog::_joinery_feature_toggled).bind(i));
+	}
+	_joinery_update_steam();
+	_joinery_update_summary();
+}
