+void ProjectDialog::_joinery_load_thread_func(void *p_userdata) {
+	ProjectDialog *self = static_cast<ProjectDialog *>(p_userdata);
+	const String home = self->joinery_home_cache;
+	// 0 apps, 1 art questions, 2 starting points, 3 brief questions.
+	const auto load = [self, &home](int p_slot, const Vector<String> &p_args) {
+		List<String> args;
+		args.push_back("run");
+		args.push_back("--project");
+		args.push_back(home);
+		args.push_back("joinery");
+		for (const String &arg : p_args) {
+			args.push_back(arg);
+		}
+		self->joinery_load_output[p_slot] = String();
+		int exit_code = -1;
+		if (OS::get_singleton()->execute("uv", args, &self->joinery_load_output[p_slot], &exit_code, true) != OK) {
+			exit_code = -1;
+		}
+		self->joinery_load_exit[p_slot] = exit_code;
+	};
 
+	if (!self->joinery_load_tools_only) {
+		// Step 1 needs only the starting points, so they come first and the
+		// cards appear while the rest is still loading.
+		load(2, { "blueprints", "--json" });
+		callable_mp(self, &ProjectDialog::_joinery_blueprints_loaded).call_deferred();
+	}
+	load(0, { "tools", "--json" });
+	if (!self->joinery_load_tools_only) {
+		load(1, { "bible", "--project", home, "--questions" });
+		load(3, { "brief", "--project", home, "--questions" });
+	}
 	callable_mp(self, &ProjectDialog::_joinery_load_finished).call_deferred();
 }
 
+void ProjectDialog::_joinery_blueprints_loaded() {
+	Dictionary doc;
+	String reason;
+	if (!_joinery_parse_json(joinery_load_output[2], joinery_load_exit[2], doc, reason) || Array(doc.get("blueprints", Array())).is_empty()) {
+		const String output = joinery_load_output[2].strip_edges();
+		const String sentence = _joinery_helper_missing(output, joinery_load_exit[2])
+				? TTR("Joinery is missing a helper it needs to list the starting points. Install it (see Details), then try again, or create a plain Godot project.")
+				: TTR("Joinery couldn't list the starting points. Try again, or create a plain Godot project.");
+		_joinery_show_banner(sentence, _joinery_catalog_details(output, joinery_load_exit[2], reason));
+		return;
+	}
+	const String chosen = joinery_blueprint >= 0 ? String(_joinery_current_blueprint().get("id", "")) : String();
+	joinery_blueprints = doc.get("blueprints", Array());
+	joinery_feature_catalog = doc.get("features", Array());
+	joinery_presets = doc.get("presets", Array());
+	joinery_preset_picker->clear();
+	for (int i = 0; i < joinery_presets.size(); i++) {
+		const Dictionary preset = joinery_presets[i];
+		joinery_preset_picker->add_item(String(preset.get("name", preset.get("id", ""))));
+		joinery_preset_picker->set_item_metadata(i, preset.get("id", ""));
+	}
+	joinery_preset_for = String();
+	joinery_features_for = String();
+	joinery_blueprints_ready = true;
+	_joinery_build_cards();
+	// Keep the card the user had, otherwise the first one.
+	int index = 0;
+	for (int i = 0; i < joinery_blueprints.size(); i++) {
+		if (String(Dictionary(joinery_blueprints[i]).get("id", "")) == chosen) {
+			index = i;
+		}
+	}
+	_joinery_card_chosen(index);
+	if (is_visible() && joinery_wizard && joinery_page != JOINERY_PAGE_CREATING) {
+		_joinery_show_step(joinery_page);
+	}
+}
