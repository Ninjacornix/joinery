+// A greybox sketch in the text colour at low strength, so it sits quietly on
+// either theme: a floor and two crates for 3D, platforms or an arena for 2D, a
+// table of cards for a UI game. The starting point's editor icon names it.
+void ProjectDialog::_joinery_draw_preview(Control *p_canvas, const String &p_dimension, const String &p_view, const String &p_icon) {
+	const Size2 size = p_canvas->get_size();
+	if (size.x <= 1 || size.y <= 1) {
+		return;
+	}
+	const float w = size.x;
+	const float h = size.y;
+	const Color ink = get_theme_color(SceneStringName(font_color), SNAME("Label"));
+	const Color ground = get_theme_color(SNAME("base_color"), EditorStringName(Editor));
+	const bool dark = EditorThemeManager::is_dark_theme();
+	Ref<StyleBoxFlat> plate;
+	plate.instantiate();
+	plate->set_bg_color(dark ? ground.lerp(Color(0, 0, 0), 0.22) : ground.lerp(Color(0, 0, 0), 0.05));
+	plate->set_corner_radius_all(4 * EDSCALE);
+	p_canvas->draw_style_box(plate, Rect2(Point2(), size));
+	const auto tone = [&ink](float p_strength) {
+		return Color(ink, p_strength);
+	};
+	const float line = MAX(1.0f, (float)EDSCALE);
+
+	if (p_dimension == "3d") {
+		const float horizon = h * 0.42;
+		p_canvas->draw_rect(Rect2(0, horizon, w, h - horizon), tone(0.05));
+		const Vector2 vanish(w * 0.5, horizon);
+		for (int i = -6; i <= 6; i++) {
+			p_canvas->draw_line(vanish, Vector2(w * 0.5 + i * w * 0.22, h), tone(0.10), line, true);
+		}
+		for (const float t : { 0.08f, 0.22f, 0.45f, 0.78f }) {
+			const float y = horizon + (h - horizon) * t;
+			p_canvas->draw_line(Vector2(0, y), Vector2(w, y), tone(0.08), line, true);
+		}
+		const auto crate = [&](const Vector2 &p_base, float p_size) {
+			const Vector2 depth(p_size * 0.36, -p_size * 0.27);
+			const Vector2 up(0, -p_size);
+			const Vector2 across(p_size, 0);
+			const PackedVector2Array front = { p_base, p_base + across, p_base + across + up, p_base + up };
+			const PackedVector2Array top = { p_base + up, p_base + across + up, p_base + across + up + depth, p_base + up + depth };
+			const PackedVector2Array side = { p_base + across, p_base + across + depth, p_base + across + up + depth, p_base + across + up };
+			p_canvas->draw_colored_polygon(side, tone(0.16));
+			p_canvas->draw_colored_polygon(top, tone(0.34));
+			p_canvas->draw_colored_polygon(front, tone(0.24));
+		};
+		crate(Vector2(w * 0.16, h * 0.88), h * 0.34);
