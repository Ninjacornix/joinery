+// "Godot, Blender, Krita" and "3 ready · 2 download on first use", counted from
+// the readiness the CLI reports for each chosen app.
+void ProjectDialog::_joinery_update_apps_summary() {
+	if (!joinery_apps_names) {
+		return;
+	}
+	String names;
+	Vector<String> labels;
+	Vector<int> counts;
+	String docker;
+	for (CheckBox *box : joinery_boxes) {
+		if (!box->is_pressed()) {
+			continue;
+		}
+		names += (names.is_empty() ? String() : String(", ")) + box->get_text();
+		String label = box->get_meta("status_label", "");
+		if (label.is_empty()) {
+			continue;
+		}
+		label = label.substr(0, 1).to_lower() + label.substr(1);
+		const int at = labels.find(label);
+		if (at < 0) {
+			labels.push_back(label);
+			counts.push_back(1);
+		} else {
+			counts.write[at] += 1;
+		}
+		if (docker.is_empty() && String(box->get_meta("status", "")) == "needs_docker") {
+			docker = box->get_meta("status_reason", "");
+			if (docker.is_empty()) {
+				docker = TTR("Docker isn't running. Start Docker, then check again.");
+			}
+		}
+	}
+	String readiness;
+	for (int i = 0; i < labels.size(); i++) {
+		readiness += (readiness.is_empty() ? String() : String::utf8(" · ")) + vformat("%d %s", counts[i], labels[i]);
+	}
+	joinery_apps_names->set_text(names.is_empty() ? TTR("No apps chosen yet.") : names);
+	joinery_apps_names->set_tooltip_text(names);
+	joinery_apps_readiness->set_text(readiness);
+	joinery_apps_readiness->set_visible(!readiness.is_empty());
+	joinery_docker_text->set_text(docker);
+	joinery_docker_row->set_visible(!docker.is_empty());
+}
