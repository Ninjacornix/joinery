+			p_canvas->draw_rect(Rect2(foot.x - r, foot.y - h * 0.24 + r, 2 * r, h * 0.24 - 2 * r), tone(0.55));
+			p_canvas->draw_circle(foot + Vector2(0, -h * 0.24 + r), r, tone(0.55), true, -1, true);
+		}
+	} else if (p_dimension == "ui") {
+		const int columns = 4;
+		const int rows = 3;
+		const float gap = MAX(3.0f, h * 0.04f);
+		const float table_w = w * 0.62;
+		const float table_h = h * 0.66;
+		const float cell_w = (table_w - gap * (columns - 1)) / columns;
+		const float cell_h = (table_h - gap * (rows - 1)) / rows;
+		const Vector2 origin((w - table_w) * 0.5, (h - table_h) * 0.5 + h * 0.04);
+		Ref<StyleBoxFlat> face;
+		face.instantiate();
+		face->set_corner_radius_all(3 * EDSCALE);
+		for (int y = 0; y < rows; y++) {
+			for (int x = 0; x < columns; x++) {
+				const int index = y * columns + x;
+				face->set_bg_color(tone(index == 5 || index == 10 ? 0.40 : 0.16));
+				p_canvas->draw_style_box(face, Rect2(origin + Vector2(x * (cell_w + gap), y * (cell_h + gap)), Size2(cell_w, cell_h)));
+			}
+		}
+	} else if (p_view == "top") {
+		// An arena seen from straight above: walls, the player, a few chasers.
+		const Rect2 arena(w * 0.10, h * 0.14, w * 0.80, h * 0.74);
+		p_canvas->draw_rect(arena, tone(0.06));
+		p_canvas->draw_rect(arena, tone(0.24), false, 2 * line);
+		p_canvas->draw_rect(Rect2(w * 0.28, h * 0.30, w * 0.08, h * 0.16), tone(0.22));
+		p_canvas->draw_rect(Rect2(w * 0.66, h * 0.58, w * 0.10, h * 0.12), tone(0.22));
+		const Vector2 player(w * 0.50, h * 0.54);
+		p_canvas->draw_circle(player, h * 0.07, tone(0.55), true, -1, true);
+		for (const Vector2 &at : { Vector2(w * 0.22, h * 0.72), Vector2(w * 0.78, h * 0.30), Vector2(w * 0.62, h * 0.24) }) {
+			const float s = h * 0.06;
+			const PackedVector2Array chaser = { at + Vector2(0, -s), at + Vector2(s, s), at + Vector2(-s, s) };
+			p_canvas->draw_colored_polygon(chaser, tone(0.32));
+		}
+	} else {
+		// A side view: ground, and for a game with a player, platforms, the
