+
+// Joinery: strip the Project Manager back to opening and creating projects.
+//
+// Most of what Godot puts here belongs to a different workflow: scanning for
+// projects on disk, per-project management, the asset store, donating. Joinery
+// drives projects from the Journeyman sidebar once one is open, so this screen
+// only has to get you into one.
+//
+// Everything is hidden, not deleted. Upstream code still constructs these and
+// still refers to them, and removing the construction is how a fork earns a
+// null dereference that compiles cleanly and crashes at runtime. Hiding also
+// means a later Godot release that moves things degrades into showing more UI
+// rather than breaking.
+void ProjectManager::_joinery_simplify() {
+	// Scanning the disk for projects is not how a Joinery project is found.
+	if (scan_btn) {
+		scan_btn->hide();
+	}
+	// Sorting: the list is short, and the default of most-recent-first is what
+	// anyone would pick anyway.
+	if (sort_label) {
+		sort_label->hide();
+	}
+	if (filter_option) {
+		filter_option->hide();
+	}
+	// Per-project management: edit, run, rename, duplicate, tags, remove.
+	// Opening a project is a double-click, and the rest belongs in the editor.
+	if (joinery_project_sidebar) {
+		joinery_project_sidebar->hide();
+	}
+	// One view, so the toggles have nothing to toggle. The asset store is a
+	// place to download assets, which is the opposite of creation-only.
+	if (main_view_toggles) {
+		main_view_toggles->hide();
+	}
+	if (quick_settings_button) {
+		quick_settings_button->hide();
+	}
+	if (donate_btn) {
+		donate_btn->hide();
+	}
 }
 
