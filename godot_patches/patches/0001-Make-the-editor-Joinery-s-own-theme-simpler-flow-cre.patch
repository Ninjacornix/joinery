+// A heading that matches the editor's own type scale, instead of a fixed pixel
+// size that goes wrong at a different interface scale.
+Label *ProjectDialog::_joinery_heading(const String &p_text) const {
+	Label *label = memnew(Label);
+	label->set_text(p_text);
+	label->set_theme_type_variation(SNAME("HeaderMedium"));
+	return label;
+}
+
+// Secondary text: body size, lightly dimmed, so it reads as guidance without
+// becoming fine print. Deliberately not a Header variation: in the editor theme
+// those are *larger* than body text, which inverts the hierarchy and is exactly
+// how this page went wrong twice.
+Label *ProjectDialog::_joinery_hint(const String &p_text) const {
+	Label *label = memnew(Label);
+	label->set_text(p_text);
+	// Body size, only dimmed. Guidance has to be readable to be guidance, and
+	// a size reduction on top of the dimming turned it into fine print.
+	label->set_modulate(Color(1, 1, 1, 0.75));
+	label->set_autowrap_mode(TextServer::AUTOWRAP_WORD_SMART);
+	label->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+	return label;
+}
+
+bool ProjectDialog::_joinery_load_questions() {
+	for (VBoxContainer *page : joinery_bible_pages) {
+		vb_root->remove_child(page);
+		memdelete(page);
+	}
+	joinery_bible_pages.clear();
+	joinery_bible_inputs.clear();
+	joinery_bible_keys.clear();
+
+	String home = _joinery_home();
+	if (home.is_empty()) {
+		return false;
+	}
+
+	List<String> args;
+	args.push_back("run");
+	args.push_back("--project");
+	args.push_back(home);
+	args.push_back("joinery");
+	args.push_back("bible");
+	args.push_back("--project");
+	args.push_back(home);
+	args.push_back("--questions");
+	String output;
+	int exit_code = 0;
+	if (OS::get_singleton()->execute("uv", args, &output, &exit_code, true) != OK || exit_code != 0) {
+		return false;
+	}
+
+	Ref<JSON> json;
+	json.instantiate();
+	if (json->parse(output) != OK) {
+		return false;
+	}
+	Array pages = Dictionary(json->get_data()).get("pages", Array());
+
+	for (int p = 0; p < pages.size(); p++) {
+		Dictionary page = pages[p];
+		VBoxContainer *container = memnew(VBoxContainer);
+		container->hide();
+		vb_root->add_child(container);
+		container->add_child(_joinery_heading(String(page.get("label", ""))));
+
+		Array page_questions = page.get("questions", Array());
+		for (int i = 0; i < page_questions.size(); i++) {
+			Dictionary question = page_questions[i];
+
+			// A question label is a label, at body size. The hint sits under it,
+			// smaller and dimmed, so the eye goes to the question first.
+			Label *label = memnew(Label);
+			label->set_text(String(question.get("label", "")));
+			container->add_child(label);
+			container->add_child(_joinery_hint(String(question.get("hint", ""))));
+
+			if (bool(question.get("multiline", false))) {
+				TextEdit *box = memnew(TextEdit);
+				box->set_custom_minimum_size(Size2(0, JOINERY_FIELD_HEIGHT) * EDSCALE);
+				box->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+				box->set_line_wrapping_mode(TextEdit::LINE_WRAPPING_BOUNDARY);
+				container->add_child(box);
+				joinery_bible_inputs.push_back(box);
+			} else {
+				LineEdit *line = memnew(LineEdit);
+				line->set_h_size_flags(Control::SIZE_EXPAND_FILL);
+				container->add_child(line);
+				joinery_bible_inputs.push_back(line);
+			}
+			joinery_bible_keys.push_back(String(question.get("key", "")));
+
+			// Breathing room between questions, which is most of what made the
+			// single long page unreadable.
+			if (i + 1 < page_questions.size()) {
+				Control *gap = memnew(Control);
+				gap->set_custom_minimum_size(Size2(0, 8) * EDSCALE);
+				container->add_child(gap);
+			}
+		}
+		joinery_bible_pages.push_back(container);
+	}
+	return !joinery_bible_pages.is_empty();
+}
+
+int ProjectDialog::_joinery_total_steps() const {
+	// Godot's fields, the tools, then one page per bible group.
+	return 2 + joinery_bible_pages.size();
+}
+
+// The first page keeps what you must decide and loses what you must read. The
+// renderer bullets, its "more information" link and the "can be changed later"
+// note are three paragraphs about a choice with three options, and "Edit Now"
+// asks whether to open a project you just asked to create.
+void ProjectDialog::_joinery_trim_first_page() {
+	if (joinery_renderer_row) {
+		// Child 0 is the radio column. Everything after it is explanation: a
+		// separator and the bullet list.
+		for (int i = 1; i < joinery_renderer_row->get_child_count(); i++) {
+			Control *child = Object::cast_to<Control>(joinery_renderer_row->get_child(i));
+			if (child) {
+				child->hide();
+			}
+		}
+	}
+	if (joinery_renderer_link) {
+		joinery_renderer_link->hide();
+	}
+	if (joinery_renderer_note) {
+		joinery_renderer_note->hide();
+	}
+	if (edit_check_box) {
+		// Always open what you just created; the checkbox only ever said no.
+		edit_check_box->set_pressed(true);
+		edit_check_box->hide();
+	}
+}
+
+void ProjectDialog::_joinery_show_step(int p_step) {
+	joinery_page = p_step;
+
+	bool first = p_step == 0;
+	name_container->set_visible(first);
+	project_path_container->set_visible(first);
+	if (first) {
+		renderer_container->set_visible(mode == MODE_NEW);
+		default_files_container->set_visible(mode == MODE_NEW);
+	} else {
+		install_path_container->hide();
+		renderer_container->hide();
+		default_files_container->hide();
+	}
+	joinery_container->set_visible(p_step == 1);
+	// The stretch spacer exists to push Godot's buttons to the bottom of a
+	// short first page. On the later pages it just opens a gap above and below
+	// the content, which is what made them look padded out.
+	if (joinery_tail_spacer) {
+		joinery_tail_spacer->set_visible(first);
+	}
+	for (int i = 0; i < joinery_bible_pages.size(); i++) {
+		joinery_bible_pages[i]->set_visible(p_step == 2 + i);
+	}
+
+	int total = _joinery_total_steps();
+	bool last = p_step >= total - 1;
+	set_ok_button_text(last ? TTRC("Create") : TTRC("Next"));
+	if (p_step == 0) {
+		set_title(vformat(TTRC("New Joinery project  (1 of %d)"), total));
+	} else if (p_step == 1) {
+		set_title(vformat(TTRC("Tools  (2 of %d)"), total));
+	} else {
+		set_title(vformat(TTRC("Art bible  (%d of %d)"), p_step + 1, total));
+	}
+	_set_message("", MESSAGE_SUCCESS);
+	// Deliberately no reset_size(): shrinking to each page's content is what
+	// made the dialog jump between a wide first page and a narrow tool list.
+	// One size for the whole flow instead.
+}
+
+void ProjectDialog::_joinery_reset_pages() {
+	joinery_page = 0;
+	if (joinery_container) {
+		joinery_container->hide();
+	}
+	for (VBoxContainer *page : joinery_bible_pages) {
+		page->hide();
+	}
+}
+
+// Hand the answers to `joinery bible`, which renders them through
+// templates/art_bible.md. Passing multi-line prose as command arguments is
+// awkward, so the answers go in a small JSON file beside the project and the
+// CLI consumes it. Rendering stays in Python so the bible's shape can change
+// without rebuilding the engine.
+void ProjectDialog::_joinery_write_bible(const String &p_path, const String &p_title) {
+	if (joinery_bible_keys.is_empty()) {
+		return;
+	}
+	Dictionary answers;
+	answers["title"] = p_title;
+	for (int i = 0; i < joinery_bible_inputs.size() && i < joinery_bible_keys.size(); i++) {
+		TextEdit *box = Object::cast_to<TextEdit>(joinery_bible_inputs[i]);
+		LineEdit *line = Object::cast_to<LineEdit>(joinery_bible_inputs[i]);
+		if (box) {
+			answers[joinery_bible_keys[i]] = box->get_text();
+		} else if (line) {
+			answers[joinery_bible_keys[i]] = line->get_text();
+		}
+	}
+
+	String answers_path = p_path.path_join(".joinery-bible-answers.json");
+	Ref<FileAccess> f = FileAccess::open(answers_path, FileAccess::WRITE);
+	if (f.is_null()) {
+		WARN_PRINT("Joinery: could not write the bible answers to " + answers_path);
+		return;
+	}
+	f->store_string(JSON::stringify(answers));
+	f->close();
+
+	String home = _joinery_home();
+	List<String> args;
+	args.push_back("run");
+	args.push_back("--project");
+	args.push_back(home);
+	args.push_back("joinery");
+	args.push_back("bible");
+	args.push_back("--project");
+	args.push_back(p_path);
+	String output;
+	int exit_code = 0;
+	if (OS::get_singleton()->execute("uv", args, &output, &exit_code, true) != OK || exit_code != 0) {
+		WARN_PRINT("Joinery: `joinery bible` did not run, so art/bible.md was not written. " + output);
+	}
+}
+
+// Joinery: put the addon into the new project and let the `joinery` CLI write
+// joinery.toml and the agent policy hooks, which is the path `joinery new`
+// takes (ADR 0004). Best effort: without Joinery or uv the user still gets a
+// working Godot project and a warning.
+void ProjectDialog::_joinery_install(const String &p_path, const String &p_tools) {
+	String home = _joinery_home();
+	if (home.is_empty()) {
+		WARN_PRINT("Joinery: JOINERY_HOME is not set, so the addon was not installed.");
+		return;
+	}
+
+	String source = home.path_join("godot_addon/joinery");
+	if (DirAccess::exists(source)) {
+		String dest = p_path.path_join("addons/joinery");
+		Ref<DirAccess> da = DirAccess::create(DirAccess::ACCESS_FILESYSTEM);
+		if (da.is_valid() && da->make_dir_recursive(dest) == OK) {
+			Ref<DirAccess> src_da = DirAccess::open(source);
+			if (src_da.is_null() || src_da->copy_dir(source, dest) != OK) {
+				WARN_PRINT("Joinery: could not copy the addon into " + dest);
+			}
+		} else {
+			WARN_PRINT("Joinery: could not create " + dest);
+		}
+	} else {
+		WARN_PRINT("Joinery: no addon at " + source);
+	}
+
+	List<String> args;
+	args.push_back("run");
+	args.push_back("--project");
+	args.push_back(home);
+	args.push_back("joinery");
+	args.push_back("setup");
+	args.push_back("--project");
+	args.push_back(p_path);
+	args.push_back("--tools");
+	args.push_back(p_tools.is_empty() ? String("godot") : p_tools);
+	String output;
+	int exit_code = 0;
+	Error cli = OS::get_singleton()->execute("uv", args, &output, &exit_code, true);
+	if (cli != OK || exit_code != 0) {
+		WARN_PRINT("Joinery: `joinery setup` did not run, so the project has no joinery.toml yet. " + output);
+	}
+}
