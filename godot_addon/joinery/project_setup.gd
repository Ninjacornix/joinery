@tool
extends AcceptDialog
## The project questionnaire: what this project is, and which tools make it.
##
## ADR 0004 wants Joinery's own screen to replace Godot's create-project
## dialog. That dialog lives in the Project Manager, which runs before any
## project is open and therefore before any plugin loads, so no addon can
## replace it; that part needs the fork patch. What a plugin *can* do is own
## the same questions for a project that is already open, writing the same
## joinery.toml that `joinery new` writes, so the answers live in one format
## either way.

const DIM := Color(0.62, 0.60, 0.56)

var _name_field: LineEdit
var _tools: Dictionary = {}
var _status: Label
var _notice: Label
var _base_font := 14


func _font(delta: int = 0) -> int:
	return maxi(10, _base_font + delta)

## Mirrors policy/preferred_tools.toml. Shown with its real state, including
## the tools whose MCP Joinery has not built yet, so the menu never implies a
## capability that does not exist.
const CATALOG: Array[Dictionary] = [
	{"id": "godot", "name": "Godot", "domain": "engine", "state": "required"},
	{"id": "blender", "name": "Blender", "domain": "3d, materials", "state": "ready"},
	{"id": "supercollider", "name": "SuperCollider", "domain": "audio", "state": "ready"},
	{"id": "gimp", "name": "GIMP", "domain": "2d", "state": "ready"},
	{"id": "inkscape", "name": "Inkscape", "domain": "2d", "state": "ready"},
	{"id": "audacity", "name": "Audacity", "domain": "audio", "state": "ready"},
	{"id": "musescore", "name": "MuseScore", "domain": "audio", "state": "ready"},
	{"id": "aseprite", "name": "Aseprite", "domain": "2d", "state": "licence"},
	{"id": "reaper", "name": "REAPER", "domain": "audio", "state": "licence"},
	{"id": "krita", "name": "Krita", "domain": "2d", "state": "planned"},
	{"id": "surge-xt", "name": "Surge XT", "domain": "audio", "state": "planned"},
	{"id": "material-maker", "name": "Material Maker", "domain": "materials", "state": "planned"},
]


func _init() -> void:
	title = "Joinery project setup"
	min_size = Vector2i(680, 700)
	ok_button_text = "Save"
	confirmed.connect(_on_save)


func _ready() -> void:
	var settings := EditorInterface.get_editor_settings()
	if settings != null and settings.has_setting("interface/editor/main_font_size"):
		_base_font = int(settings.get_setting("interface/editor/main_font_size"))

	var root := VBoxContainer.new()
	root.add_theme_constant_override("separation", 8)
	add_child(root)

	_notice = Label.new()
	_notice.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_notice.visible = false
	_notice.add_theme_color_override("font_color", Color(0.9, 0.7, 0.4))
	root.add_child(_notice)

	_add_heading(root, "This project")
	var row := HBoxContainer.new()
	root.add_child(row)
	var label := Label.new()
	label.text = "Name"
	label.custom_minimum_size = Vector2(90, 0)
	row.add_child(label)
	_name_field = LineEdit.new()
	_name_field.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(_name_field)

	_add_heading(root, "Tools that make this project")
	_add_note(
		root,
		"Preferred tools are non-generative and send no telemetry. You can add "
		+ "your own program per project; its output is labelled custom-tool and "
		+ "is never recorded as tool-created."
	)

	for entry: Dictionary in CATALOG:
		_add_tool_row(root, entry)

	_add_heading(root, "Rule Zero")
	_add_note(
		root,
		"Assets are made by operating these tools, never generated by a model. "
		+ "Every asset keeps a recipe that remakes it, and the gate blocks a "
		+ "generative service whichever agent you run."
	)

	_status = Label.new()
	_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_status.add_theme_color_override("font_color", DIM)
	root.add_child(_status)


func _add_heading(parent: Node, text: String) -> void:
	parent.add_child(HSeparator.new())
	var label := Label.new()
	label.text = text
	label.add_theme_font_size_override("font_size", _font(3))
	parent.add_child(label)


func _add_note(parent: Node, text: String) -> void:
	var label := Label.new()
	label.text = text
	label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	label.add_theme_color_override("font_color", DIM)
	label.add_theme_font_size_override("font_size", _font(0))
	parent.add_child(label)


func _add_tool_row(parent: Node, entry: Dictionary) -> void:
	var row := HBoxContainer.new()
	parent.add_child(row)

	var box := CheckBox.new()
	box.text = entry["name"]
	box.custom_minimum_size = Vector2(170, 0)
	match entry["state"]:
		"required":
			box.button_pressed = true
			box.disabled = true
			box.tooltip_text = "The engine itself. Always on."
		"planned":
			box.disabled = true
			box.tooltip_text = "Joinery is building this tool's server. Not selectable yet."
		"licence":
			box.tooltip_text = "Needs your own licence for this program."
	row.add_child(box)
	_tools[entry["id"]] = box

	var domain := Label.new()
	domain.text = entry["domain"]
	domain.custom_minimum_size = Vector2(120, 0)
	domain.add_theme_color_override("font_color", DIM)
	domain.add_theme_font_size_override("font_size", _font(0))
	row.add_child(domain)

	var state := Label.new()
	state.text = {
		"required": "required",
		"ready": "",
		"licence": "your licence",
		"planned": "server not built",
	}.get(entry["state"], "")
	state.add_theme_color_override("font_color", DIM)
	state.add_theme_font_size_override("font_size", _font(0))
	row.add_child(state)


func open_for_current_project() -> void:
	_notice.visible = false
	_name_field.text = ProjectSettings.get_setting("application/config/name", "")
	_load_enabled()
	_status.text = "Saves to joinery.toml, the same file `joinery setup` writes."
	popup_centered()


func open_for_new_project() -> void:
	## Straight after the Project Manager's Next button. The project exists and
	## is a valid Godot project; what is missing is the decision about which
	## tools will make it, which is what this asks.
	_notice.text = (
		"Project created. Now choose the tools that will make it. Preferred "
		+ "tools are non-generative and send no telemetry; you can add your own "
		+ "program later, and its output is labelled custom-tool."
	)
	_notice.visible = true
	_name_field.text = ProjectSettings.get_setting("application/config/name", "")
	_load_enabled()
	_status.text = "Saves to joinery.toml, the same file `joinery new` writes."
	popup_centered()


func open_new_project_notice() -> void:
	## Creating a project is a Project Manager job, so a plugin cannot own it.
	_notice.text = (
		"Creating a *new* project cannot be done from inside an open project: "
		+ "Godot's Project Manager runs before any plugin loads. Use "
		+ "`joinery new <path>` for now, which asks these same questions. "
		+ "Replacing the Project Manager screen itself is a fork patch (ADR 0004)."
	)
	_notice.visible = true
	open_for_current_project()
	_notice.visible = true


func _load_enabled() -> void:
	var path := "res://joinery.toml"
	if not FileAccess.file_exists(path):
		return
	var text := FileAccess.get_file_as_string(path)
	# Small, deliberate parse: only the enabled list matters here, and Godot
	# has no TOML reader. `joinery setup` owns the real file.
	var start := text.find("enabled")
	if start == -1:
		return
	var open_bracket := text.find("[", start)
	var close_bracket := text.find("]", open_bracket)
	if open_bracket == -1 or close_bracket == -1:
		return
	var inner := text.substr(open_bracket + 1, close_bracket - open_bracket - 1)
	var enabled: Array[String] = []
	for raw: String in inner.split(","):
		var id := raw.strip_edges().trim_prefix('"').trim_suffix('"')
		if not id.is_empty():
			enabled.append(id)
	for id: String in _tools:
		var box: CheckBox = _tools[id]
		if not box.disabled:
			box.button_pressed = enabled.has(id)


func _on_save() -> void:
	var chosen: Array[String] = []
	for id: String in _tools:
		var box: CheckBox = _tools[id]
		if box.button_pressed:
			chosen.append(id)
	chosen.sort()

	var engine_dir := OS.get_environment("JOINERY_HOME")
	if engine_dir.is_empty():
		engine_dir = ProjectSettings.globalize_path("res://").path_join("..").simplify_path()
	var project := ProjectSettings.globalize_path("res://").rstrip("/")

	# Hand off to the CLI rather than writing the file here: `joinery setup`
	# validates the choice against the catalog, so an unavailable tool cannot be
	# smuggled in through the UI.
	var args := PackedStringArray([
		"run", "--project", engine_dir, "joinery", "setup",
		"--project", project, "--tools", ",".join(chosen),
	])
	var out: Array = []
	var code := OS.execute("uv", args, out, true)
	var text: String = "\n".join(out).strip_edges()

	if _name_field.text.strip_edges() != "":
		ProjectSettings.set_setting(
			"application/config/name", _name_field.text.strip_edges()
		)
		ProjectSettings.save()

	_status.text = ("Saved: %s" % text) if code == 0 else ("Refused: %s" % text)
	print("[Joinery] setup exit=%d %s" % [code, text])
